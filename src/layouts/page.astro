---
import Main from './main.astro';
const { title, name, desc, subs } = Astro.props;
---

<Main title={title} desc={desc}>
  <section>
    <div class="container py-20 px-6 mx-auto">
      <div class="text-center">
        <h1 class="font-bold font-josefin text-4xl md:text-5xl text-blue-600">{name}</h1>
        <p class="text-gray-500 font-poppins max-w-prose mx-auto mt-2">{subs}</p>
      </div>
      <div class="mx-auto my-8 py-6">
        <slot />
      </div>
    </div>
  </section>
</Main>
