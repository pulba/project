---
import Main from './main.astro';
interface Props {
  title: string;
  desc?: string;
  name?: string;
  subs?: string;
}
const { title, name, desc, subs } = Astro.props as Props;
---

<Main title={title} desc={desc}>
  <section>
    <div class="container relative mx-auto">
      <div class="relative text-center text-gray-50 px-6 w-full h-64 flex flex-col justify-center items-center bg-cover bg-center before:content-[''] before:absolute before:opacity-70 before:inset-0 before:bg-gray-900" style="background-image: url(/assets/img-30.webp);">
        <h1 class="relative font-bold font-josefin text-3xl md:text-4xl">{name}</h1>
        <p class="relative font-poppins max-w-prose mx-auto mt-2">{subs}</p>
      </div>
      <div class="mx-auto my-8 p-6">
        <slot />
      </div>
    </div>
  </section>
</Main>
