---
import { Icon } from 'astro-icon/components';
const { txfs, txth, bgfs, bgth, before, datefs, datesc, timefs, timesc, locationfs, locationsc, addressfs, addresssc, mapsfs, mapssc, akad, resepsi, cols } = Astro.props;

---
<div class=`grid gird-cols-1 md:grid-cols-${cols} max-w-2xl w-full mx-auto justify-center items-center gap-4 mt-5 *:mx-auto *:border-[1px] *:rounded-2xl *:h-full *:w-full *:shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] *:before:content-[''] *:before:absolute *:before:opacity-25 *:before:left-0 *:before:w-full *:before:h-full *:before:rounded-2xl`>
  <div class=`flip-right opacity-0 relative ${before} ${txth}`>
    <div class="space-y-3 px-6 md:px-12 py-8 relative z-10">
      <h2 class="text-center font-dyna text-4xl">{akad}</h2>
      <p class="text-lg font-bold flex gap-2">
        <Icon name="mdi:date-range" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
        {datefs}
      </p>
      <p class="text-md flex gap-2">
        <Icon name="mdi:clock-time-eight-outline" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
        {timefs}
      </p>
      <p class="flex gap-2">
        <Icon name="mdi:home" class="w-6 h-6 flex-shrink-0 min-w-max" />
        {locationfs}
      </p>
      <p class="flex gap-2 text-left">
        <Icon name="mdi:google-maps" class="w-6 h-6 flex-shrink-0 min-w-max" />
        {addressfs}
      </p>
      <div class="group">
        <a href={mapsfs}>
          <button
            class={`mx-auto mt-8 flex items-center justify-center rounded-full px-4 py-2 text-center text-sm font-medium shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${txfs} ${bgth}`}
          >
            Google Maps
            <Icon name="mdi:google-maps" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
          </button>
        </a>
      </div>
    </div>
  </div>
  <div class=`flip-left opacity-0 relative ${before} ${txth}`>
    <div class="space-y-3 px-6 md:px-12 py-8 relative z-10">
      <h2 class="text-center font-dyna text-4xl">{resepsi}</h2>
      <p class="text-lg font-bold flex gap-2">
        <Icon name="mdi:date-range" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
        {datesc}
      </p>
      <p class="text-md flex gap-2">
        <Icon name="mdi:clock-time-eight-outline" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
        {timesc}
      </p>
      <p class="flex gap-2">
        <Icon name="mdi:home" class="w-6 h-6 flex-shrink-0 min-w-max" />
        {locationsc}
      </p>
      <p class="flex gap-2 text-left">
        <Icon name="mdi:google-maps" class="w-6 h-6 flex-shrink-0 min-w-max" />
        {addresssc}
      </p>
      <div class="group">
        <a href={mapssc}>
          <button
            class={`mx-auto mt-8 flex items-center justify-center rounded-full px-4 py-2 text-center text-sm font-medium shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${txfs} ${bgth}`}
          >
            Google Maps
            <Icon name="mdi:google-maps" class="w-6 h-6 flex-shrink-0 min-w-[1.5rem]" />
          </button>
        </a>
      </div>
    </div>
  </div>
</div>