    </div>
  </div>
  
</div>

<div class=`relative flex flex-col sm:flex-row gap-6 items-center justify-center max-w-sm sm:max-w-xl mx-auto mt-12 ${important} ${primaryClassesSecond}`>
  <div class=`flip-left opacity-0 relative bg-cover bg-center rounded-full my-auto flex flex-col items-center w-full h-screen before:content-[''] before:absolute before:h-full before:w-full before:bg-black/50 before:rounded-full before:z-10 ${animation}`
  style=`background-image: url('${dekorfv}')`> 
    <img src=`${imgstory1}` alt="JejakBahagia" class="absolute w-full h-full p-2 bg-cover bg-center rounded-full">
    <div class=`relative flex flex-col items-center justify-center w-full h-full py-6 px-6 font-poppins my-auto z-20 mx-auto text-center ${txfs}`>
      <h2 class=`text-center text-4xl ${font}`>{akad}</h2>
      <img src=`${dekorsx}` class="w-28 h-28" alt="JejakBahagia">
      <p class="text-lg uppercase">{dayfs}</p>
      <div class=`flip-up opacity-0 flex flex-row jusfity-evenly items-center w-full border-y-2 py-3 *:w-full *:text-md *:uppercase ${animation}`>
        <p>{month}</p>
        <div class="!text-5xl font-bold uppercase">{datefs}</div>
        <p>{year}</p>
      </div>
      <div class="text-sm pt-5 flex flex-col items-center">
        <p class="flex items-center">
          <Icon path="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" primary="w-4 h-4 flex-shrink-0 min-w-[1.5rem]" />
          {timefs}
        </p>
        <p>{locationfs}</p>
        <p>{addressfs}</p>
        <Button href={mapsfs} button={button} txfs={txfs} bgth={bgth} title="Google Maps" path="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" primary="w-4 h-4">
      </div>
    </div>
  </div>
  <div
  class=`flip-right opacity-0 relative z-50 bg-cover bg-center rounded-full my-auto flex flex-col items-center w-full h-screen before:content-[''] before:absolute before:h-full before:w-full before:bg-black/50 before:rounded-full before:z-10 ${animation}`
  style=`background-image: url('${dekorfv}')`>
    <img src=`${imgstory2}` alt="JejakBahagia" class="absolute w-full h-full p-2 bg-cover bg-center rounded-full">
    <div class=`relative flex flex-col items-center justify-center w-full h-full py-6 px-6 font-poppins my-auto z-20 mx-auto text-center ${txfs}`>
      <h2 class=`text-center text-4xl ${font}`>{resepsi}</h2>
      <img src=`${dekorsx}` class="w-28 h-28" alt="JejakBahagia">
      <p class="text-lg uppercase">{daysc}</p>
      <div class=`flip-up opacity-0 flex flex-row jusfity-evenly items-center w-full border-y-2 py-3 *:w-full *:text-md *:uppercase ${animation}`>
        <p>{month}</p>
        <div class="!text-5xl font-bold uppercase">{datesc}</div>
        <p>{year}</p>
      </div>
      <div class="text-sm pt-5 flex flex-col items-center">
        <p class="flex items-center">
          <Icon path="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" primary="w-4 h-4 flex-shrink-0 min-w-[1.5rem]" />
          {timesc}
        </p>
        <p>{locationsc}</p>
        <p>{addresssc}</p>
        <Button href={mapssc} button={button} txfs={txfs} bgth={bgth} title="Google Maps" path="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" primary="w-4 h-4">
      </div>
    </div>
  </div>
</div>