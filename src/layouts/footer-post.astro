---
import Icon from '../components/icon.astro';
import BorderSingle from './borderSingle.astro';
import Decor from './decor.astro';
import Shapes from './shapes.astro';
const { bgfs, txfs, txsc, txth, bgth, styleBs, font, dekorth, image, female, male, fillfs, fillsc, fillth, primary } = Astro.props;
const { dekorProps } = Astro.props;
--- 

<section class=`animasi8 relative overflow-hidden ${bgfs} ${txth}`>
  <Shapes fillfs={fillfs} fillsc={fillsc} fillth={fillth} primary="rotate-180 -mb-1 absolute bottom-0 left-0 z-30" />
  <Decor {...dekorProps} animations={['fade-left', 'fade-right', 'fade-left', 'fade-right']} hiddenProps={['hidden', `hidden`, ``, '']} />
  <div class="container px-6 py-12 text-center mx-auto relative z-10">
    <div class="relative min-h-screen flex flex-col justify-evenly items-center w-full">
      <BorderSingle image={image} dekorth={dekorth} styleBs={styleBs} primary={primary} />
      <p class=`fade-left opacity-0 text-center text-sm max-w-prose mx-auto ${txsc}`>Merupakan suatu kehormatan dan kebahagiaan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu. Atas kehadiran dan doa restunya, kami mengucapkan terima kasih. <br>
        <span class=`fade-right opacity-0 text-center capitalize !text-2xl md:!text-4xl ${font}`>Wassalamu’alaikum Wr. Wb.</span>
      </p>
      <p class="fade-left opacity-0 text-center mt-5">Kami Yang Berbahagia</p>
      <p class=`fade-right opacity-0 text-center ${font} ${txth}`>{female} & {male}</p>
    </div>
  </div>
</section>
<footer class=`${bgth}`>
  <div class="py-12 mx-auto">
    <div class="text-center mx-auto relative z-10">
      <div class="flex flex-col items-center justify-center">
        <a href="/"
          class=`mx-auto text-sm font-poppins text-center flex justify-center items-center gap-1 ${txfs}`>
          Made with 
          
          <img src=`/assets/favicon.png` alt="JejakBahagia" class="w-8 h-full"/> JejakBahagia
        </a>
        <div class="grid grid-cols-4 gap-4 mt-5 [&>*]:flex [&>*]:flex-row [&>*]:gap-2 [&>*]:justify-center [&>*]:items-center">
          <div>
            <a href="https://www.instagram.com/jejakbahagia_/" class="flex flex-row gap-2 items-center">
              <Icon path="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" primary=`w-8 h-8 ${bgfs} ${txth} rounded-xl p-1` />
            </a>
          </div>
          <div>
            <a href="https://web.facebook.com/jejakbahagia02" class="flex flex-row gap-2 items-center">
            <Icon path="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" primary=`w-8 h-8 ${bgfs} ${txth} rounded-xl p-1` />
          </a>
          </div>
          <div>
            <a href="https://mail.google.com/mail/u/0/?view=cm&tf=1&fs=1&to=jejakbahagiainfo@gmail.com" class="flex flex-row gap-2 items-center">
            <Icon path="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 10.692 6.33 6.33 0 0 0 10.857-4.424V8.687a8.182 8.182 0 0 0 4.773 1.526V6.79a4.831 4.831 0 0 1-1.003-.104z" primary=`w-8 h-8 ${bgfs} ${txth} rounded-xl p-1` />
          </a>
          </div>
          <div>
            <a href="https://wa.me/6281532094978?text=Hallo admin Jejak Bahagia, buat undangan dong!" class="flex flex-row items-center gap-2">
            <Icon path="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" primary=`w-8 h-8 ${bgfs} ${txth} rounded-xl p-1` />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
