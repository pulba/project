---
import BankCard from "./BankCard.astro";
import Copy from "../components/copy.astro"
const { txth, numberbankml, numberbankfml, namebankml, namebankfml, logoml, logofml, from, via, to, row, animation } = Astro.props;
---

<div class={`relative flex flex-col md:flex-${row} gap-8 justify-center w-full max-w-screen-md mx-auto mt-12 z-50 *:relative *:overflow-hidden *:mx-auto *:w-full *:h-full *:max-w-xs *:gap-5 *:rounded-2xl *:border-[1px] *:shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${txth}`}>
  <BankCard 
    logo={logoml}
    name={namebankml}
    number={numberbankml}
    classNames={`flip-left opacity-0 ${animation} ${txth}`}
  />
  <BankCard 
    logo={logofml}
    name={namebankfml}
    number={numberbankfml}
    classNames={`flip-left opacity-0 ${animation} ${txth}`}
  />
</div>
<Copy/>

