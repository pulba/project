---
const { image, dekorfv, styleBs, primary, important, animation } = Astro.props;
const primaryClassesFirst = primary === "hidden" ? "hidden" : "block";
const primaryClassesSecond = primary === "hidden" ? "block" : "hidden";
---

<div class=`flip-left opacity-0 relative flex items-center justify-center w-60 md:w-72 ${important} ${animation} ${primaryClassesFirst}`>
  <div class=`w-52 h-52 md:w-64 md:h-64 bg-cover bg-center relative ${styleBs}`
    style=`background-image:url(${image})`>
  </div>
  <img
    src={dekorfv}
    alt="JejakBahagia"
    class={`absolute ${dekorfv ? "" : "hidden"}`}/>
</div>

<div class=`flip-right opacity-0 relative flex items-center justify-center ${important} ${animation} ${primaryClassesSecond}`>
  <div class=`bg-cover bg-center relative ${styleBs}`
  style=`background-image: url('${dekorfv}')`>
  </div>
  <img src=`${image}` alt="JejakBahagia" class=`absolute bg-cover bg-center ${styleBs}`>
</div>