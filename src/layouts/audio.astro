---
import Icon from '../components/icon.astro';
const { bgth, txfs, bdr } = Astro.props
---

<div class="audio fixed bottom-5 right-5 z-50">
  <div x-data="{ playing: false }" id="playPauseBtn" class=`relative flex items-end justify-end rounded-full p-2 ml-auto w-max border-[1px] ${bgth} ${txfs} ${bdr}`>
    <button x-show="!playing" x-on:click="playing = true; document.getElementById('myAudio').pause()">
        <Icon path="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" primary="w-8 h-8"/>
    </button>
    <button x-show="playing" x-on:click="playing = false; document.getElementById('myAudio').play()">
        <Icon path="M17.25 9.75 19.5 12m0 0 2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6 4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" primary="w-8 h-8" />
    </button>
  </div>
</div>

  <script>

    var btn = document.getElementById('playPauseBtn');
    var btnaudio = document.getElementById('toaudio');
    var audio = document.getElementById('myAudio') as HTMLAudioElement;
    
    if(btnaudio) {
      btnaudio.addEventListener('click', function() {
      audio.play();
      });
      document.addEventListener("DOMContentLoaded", function() {
        if (btn && audio) {
            btn.addEventListener('click', function() {
                if (audio.paused) {
                    audio.play();
                } else {
                    audio.pause();
                }
            });
        } 
      });
    }
    
  
  </script>