---
import Icon from "../components/icon.astro"

const {
  imgstory1,
  imgstory2,
  imgstory3,
  storyfs,
  storysc,
  storyth,
  txfs,
  txth,
  bgth,
  font,
} = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 py-12">
    <div class="relative">
      <!-- Vertical line -->
      <div class=`absolute left-6 top-0 h-full w-px ${bgth}`></div>
      <!-- ITEM 1 -->
      <div class="relative flex gap-6">
        <div class="z-10 shrink-0">
          <div class=`relative flex h-12 w-12 items-center justify-center rounded-full shadow-lg ${txfs} ${bgth}`>
             <Icon path="M8 14q-.425 0-.713-.288T7 13q0-.425.288-.713T8 12q.425 0 .713.288T9 13q0 .425-.288.713T8 14Zm4 0q-.425 0-.713-.288T11 13q0-.425.288-.713T12 12q.425 0 .713.288T13 13q0 .425-.288.713T12 14Zm4 0q-.425 0-.713-.288T15 13q0-.425.288-.713T16 12q.425 0 .713.288T17 13q0 .425-.288.713T16 14ZM3 22V4h3V2h2v2h8V2h2v2h3v18H3Zm2-2h14V10H5v10Z" primary="w-6 h-6" />
          </div>
        </div>
        <article class="fade-up opacity-0 relative ml-2 w-full">
            <div class="absolute top-3 -left-[1.7rem] w-7 overflow-hidden inline-block">
                <div class=`h-12 -rotate-45 transform origin-top-right ${bgth}`></div>
               </div>
          <div class=`w-full rounded-2xl p-3 md:p-5 overflow-hidden ${bgth}`>
            <!-- Gambar -->
            <div class="aspect-[16/10] w-full overflow-hidden">
              <img
                src={imgstory1}
                alt="undangan pernikahan digital"
                class="h-full w-full object-cover object-center rounded-2xl"
              />
            </div>
            <div class="space-y-3 p-3 md:p-5">
                <p class=`${font} ${txfs}`>Awal Cerita</p>
                <p class=`${txfs} text-sm italic leading-relaxed`>{storyfs}</p>
            </div>
          </div>
        </article>
      </div>
      <!-- === ITEM 2 === -->
      <div class="relative flex gap-6 py-8">
        <div class="z-10 shrink-0">
          <div class=`relative flex h-12 w-12 items-center justify-center rounded-full shadow-lg ${txfs} ${bgth}`>
             <Icon path="M12.001 20.727c-.315 0-.63-.103-.889-.308C8.45 18.74 3 14.4 3 9.353 3 6.493 5.303 4.2 8.145 4.2c1.63 0 3.208.77 4.156 1.975C13.25 4.969 14.828 4.2 16.458 4.2 19.3 4.2 21.6 6.493 21.6 9.353c0 5.047-5.45 9.386-8.112 11.066a1.48 1.48 0 0 1-.887.308Z" primary="w-6 h-6" />
          </div>
        </div>
        <article class="fade-up opacity-0 relative ml-2 w-full">
            <div class="absolute top-3 -left-[1.7rem] w-7 overflow-hidden inline-block">
                <div class=`h-12 -rotate-45 transform origin-top-right ${bgth}`></div>
               </div>
          <div class=`w-full rounded-2xl p-3 md:p-5 overflow-hidden ${bgth}`>
            <!-- Gambar -->
            <div class="aspect-[16/10] w-full overflow-hidden">
              <img
                src={imgstory2}
                alt="undangan pernikahan digital"
                class="h-full w-full object-cover object-center rounded-2xl"
              />
            </div>
            <div class="space-y-3 p-3 md:p-5">
                <p class=`${font} ${txfs}`>Lamaran</p>
                <p class=`${txfs} text-sm italic leading-relaxed`>{storysc}</p>
            </div>
          </div>
        </article>
      </div>
      <!-- === ITEM 3 === -->
      <div class="relative flex gap-6">
        <div class="z-10 shrink-0">
          <div class=`relative flex h-12 w-12 items-center justify-center rounded-full shadow-lg ${txfs} ${bgth}`>
             <Icon path="M6 3h12l4 6l-10 12L2 9l4-6ZM2 9h20M11 3L7 9l5 11m1-17l4 6l-5 11" primary="w-6 h-6" />
          </div>
        </div>
        <article class="fade-up opacity-0 relative ml-2 w-full">
            <div class="absolute top-3 -left-[1.7rem] w-7 overflow-hidden inline-block">
                <div class=`h-12 -rotate-45 transform origin-top-right ${bgth}`></div>
               </div>
          <div class=`w-full rounded-2xl p-3 md:p-5 overflow-hidden ${bgth}`>
            <!-- Gambar -->
            <div class="aspect-[16/10] w-full overflow-hidden">
              <img
                src={imgstory3}
                alt="undangan pernikahan digital"
                class="h-full w-full object-cover object-center rounded-2xl"
              />
            </div>
            <div class="space-y-3 p-3 md:p-5">
                <p class=`${font} ${txfs}`>Menikah</p>
                <p class=`${txfs} text-sm italic leading-relaxed`>{storyth}</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>