---
import Icon from "../components/icon.astro";
import BorderSingle from "./borderSingle.astro";
export interface CoupleProps {
  important: string;
  animation: string;
  brideflex: string;
  pm1: string;
  pm2: string;
  dekorfv: string;
  txsc: string;
  styleBs: string;
  primary: string;
  txfs: string;
  bgth: string;
  font: string;
  fullfemale: string;
  childfemale: string;
  parentfemale: string;
  instagramfemale: string;
  male: string;
  fullmale: string;
  childmale: string;
  parentmale: string;
  instagrammale: string;
}

const {
  important,
  animation,
  brideflex,
  pm1,
  pm2,
  dekorfv,
  txsc,
  styleBs,
  primary,
  txfs,
  bgth,
  font,
  fullfemale,
  childfemale,
  parentfemale,
  instagramfemale,
  fullmale,
  childmale,
  parentmale,
  instagrammale,
} = Astro.props as CoupleProps;
---

<div class="relative z-30 flex flex-col lg:flex-row justify-center items-center gap-y-8 w-full max-w-4xl mx-auto mt-5 *:text-center *:w-full *:flex *:flex-col *:justify-evenly *:gap-4 *:items-center">
  <div class=`${brideflex}`>
      <BorderSingle image={pm1} dekorfv={dekorfv} styleBs={styleBs} primary={primary} important={important} animation={animation}/>
    <div class="">
      <h3 class=`fade-up opacity-0 mt-6 ${important} ${animation} ${txsc} ${font}`>
        {fullfemale}
      </h3>
      <div class=`fade-up opacity-0 space-y-3 ${important} ${animation} ${txsc}`>
        <div>
          <p>{childfemale}</p>
          <p class=`${txsc}`>{parentfemale}</p>
          <div class="flex gap-3 text-center justify-center mt-4">
            <a
              href=`https://www.instagram.com/${instagramfemale}`
              class=`flex flex-row gap-2 p-1 items-center rounded-full shadow-[0.0px_4.0px_6.0px_rgba(0,0,0,0.35)] ${txfs} ${bgth}`
            >
              <Icon path="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3Z" primary="w-6 h-6" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class=`${brideflex}`>
    <BorderSingle image={pm2} dekorfv={dekorfv} styleBs={styleBs} primary={primary} important={important} animation={animation} />
    <div class="">
      <h3 class=`fade-up opacity-0 mt-6 ${animation} ${important} ${txsc} ${font}`>
        {fullmale}
      </h3>
      <div class=`fade-up opacity-0 space-y-3 ${animation}  ${important} ${txsc}`>
        <div>
          <p>{childmale}</p>
          <p class=`${txsc}`>{parentmale}</p>
          <div class="flex gap-3 text-center justify-center mt-4">
            <a
              href=`https://www.instagram.com/${instagrammale}`
              class=`flex flex-row gap-2 p-1 items-center rounded-full shadow-[0.0px_4.0px_6.0px_rgba(0,0,0,0.35)] ${txfs} ${bgth}`
            >
              <Icon path="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3Z" primary="w-6 h-6" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
