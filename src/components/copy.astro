<script is:inline>
    document.addEventListener('click', (e) => {
      if (!e.target.classList.contains('copy-btn')) return;
      
      const button = e.target;
      const content = button.closest('.flip-left').querySelector('.copy-content').textContent;
      
      navigator.clipboard.writeText(content)
        .then(() => {
          button.textContent = 'Rekening Disalin!';
          button.classList.replace('bg-gray-500', 'bg-gray-400');
          
          setTimeout(() => {
            button.textContent = 'Salin Rekening';
            button.classList.replace('bg-gray-400', 'bg-gray-500');
          }, 1000);
        })
        .catch(console.error);
    });
  </script>