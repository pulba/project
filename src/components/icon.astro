---
interface Props {
    path?: string;
    primary?: string;
}
const { path, primary } = Astro.props as Props;
---

<svg
  data-slot="icon"
  class={primary}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width=".5"
>
  <path d={path} fill="currentColor"></path>
</svg>