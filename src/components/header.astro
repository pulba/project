---
import "@fontsource/poppins";
import "@fontsource/mr-de-haviland";
import "@fontsource/the-nautigal";
import Logo from "./logo.astro";
import Button from "./button.astro";
---


<style>
  .menu-enter {
    opacity: 0;
    transform: scale(0.98);
  }
  .menu-enter-active {
    opacity: 1;
    transform: scale(1);
    transition: all 150ms ease;
  }
  .menu-exit {
    opacity: 1;
    transform: scale(1);
  }
  .menu-exit-active {
    opacity: 0;
    transform: scale(0.98);
    transition: all 300ms ease-in-out;
  }
</style>

<header
  class="sticky top-0 z-50 bg-white/80 backdrop-blur drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.5)]">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    aria-label="Navigasi utama">
    <div class="flex h-16 items-center justify-between">
      <Logo file="jejakbahagia" />

      <!-- Center: Desktop menu -->
      <ul class="hidden relative sm:flex items-center gap-1 *:relative *:px-3 *:py-2 *:rounded-lg *:font-medium *:focus:outline-none *:focus-visible:ring-2 *:focus-visible:ring-gray-300 *:before:content-[''] *:before:absolute *:before:bottom-1 *:before:bg-blue-900 *:before:h-0 *:before:w-0 hover:*:text-blue-900 hover:*:before:w-[60%] hover:*:before:h-[2px] *:before:ease-linear *:before:duration-300"
        role="menubar">
        <li role="none"><a role="menuitem" href="/">Home</a></li>
        <li role="none"><a role="menuitem" href="/katalog">Katalog</a></li>
        <li role="none"><a role="menuitem" href="/fitur">Fitur</a></li>
        <li role="none"><a role="menuitem" href="/contact">Contact</a></li>
      </ul>

      <!-- Right: CTA (desktop) -->
      <div class="hidden sm:flex items-center">
        <a href="https://api.whatsapp.com/send/?phone=6281532094978&text=Hallo+Admin+Jejak+Bahagia%2C+saya+mau+konsultasi+undangan+digital+dong%21&type=phone_number&app_absent=0" class="relative rounded-full ring-2 ring-blue-900 px-6 py-2 font-semibold text-white font-poppins transition before:content-[''] before:absolute before:bg-blue-900 before:w-full before:h-full before:rounded-full before:top-0 before:left-0 before:-z-10 before:ease-in-out before:duration-700 hover:text-blue-900 hover:before:w-0"
        >Konsultasi
        </a>
      </div>

      <!-- Right: Mobile toggler -->
      <button id="navbarToggle" class="sm:hidden inline-flex items-center justify-center rounded-xl p-2.5 text-gray-700 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-300">
        <svg id="iconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round"> <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="iconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          class="h-6 w-6 hidden" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="relative z-50 sm:hidden hidden" aria-hidden="true">
      <div class="pb-6 pt-2">
        <ul class="space-y-1 *:block *:rounded-lg *:px-3 *:py-2 *:text-base *:font-medium hover:*:bg-gray-100 *:focus:outline-none *:focus-visible:ring-2 *:focus-visible:ring-gray-300" role="menubar">
          <li role="none"><a role="menuitem" href="/">Home</a></li>
          <li role="none"><a role="menuitem" href="/katalog">Katalog</a></li>
          <li role="none"><a role="menuitem" href="/fitur">Fitur</a></li>
          <li role="none"><a role="menuitem" href="/contact">Contact</a></li>
        </ul>
        <div class="mt-3">
          <a href="https://api.whatsapp.com/send/?phone=6281532094978&text=Hallo+Admin+Jejak+Bahagia%2C+saya+mau+konsultasi+undangan+digital+dong%21&type=phone_number&app_absent=0" class="relative block w-full text-center rounded-full ring-2 ring-blue-900 px-6 py-2 font-semibold text-white font-poppins transition before:content-[''] before:absolute before:bg-blue-900 before:w-full before:h-full before:rounded-full before:top-0 before:left-0 before:-z-10 before:ease-in-out before:duration-700 hover:text-blue-900 hover:before:w-0">
            Konsultasi
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  (function () {
    const toggleBtn = document.getElementById("navbarToggle");
    const menu = document.getElementById("mobileMenu");
    const iconOpen = document.getElementById("iconOpen");
    const iconClose = document.getElementById("iconClose");

    function openMenu() {
      menu.classList.remove("hidden");
      menu.setAttribute("aria-hidden", "false");
      toggleBtn.setAttribute("aria-expanded", "true");
      iconOpen.classList.add("hidden");
      iconClose.classList.remove("hidden");
      // Simple enter animation
      menu.classList.add("menu-enter");
      requestAnimationFrame(() => menu.classList.add("menu-enter-active"));
      setTimeout(
        () => menu.classList.remove("menu-enter", "menu-enter-active"),
        180,
      );
    }

    function closeMenu() {
      // Simple exit animation
      menu.classList.add("menu-exit");
      requestAnimationFrame(() => menu.classList.add("menu-exit-active"));
      setTimeout(() => {
        menu.classList.remove("menu-exit", "menu-exit-active");
        menu.classList.add("hidden");
        menu.setAttribute("aria-hidden", "true");
        toggleBtn.setAttribute("aria-expanded", "false");
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
      }, 140);
    }

    toggleBtn.addEventListener("click", () => {
      const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
      expanded ? closeMenu() : openMenu();
    });

    // Tutup menu saat ESC ditekan
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
        if (expanded) closeMenu();
      }
    });

    // Tutup menu saat klik di luar (pada viewport kecil)
    document.addEventListener("click", (e: MouseEvent) => {
      const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
      if (!expanded) return;

      const nav = toggleBtn.closest("nav");
      if (!nav) return;

      const path = e.composedPath(); // EventTarget[]
      if (!path.includes(nav)) {
        closeMenu();
      }
    });
  })();
</script>
