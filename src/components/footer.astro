---
import Icon from '../components/icon.astro';
import Logo from './logo.astro';
const facebook = "facebook";
const userfb = "jejakbahagia";
const instagram = "instagram";
const userig = "jejakbahagia_";
---


<footer class="bg-blue-900">
  <div class="container mx-auto pt-20 pb-2 px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 font-poppins">
      <div class="flex flex-col items-center md:items-start space-y-2 text-white">
        <Logo file="jejakbahagiasc"/>
        <p class="text-center md:text-left">Solusi pernikahan lebih hemat, praktis, dan kekinian dengan JejakBahagia yang disebar otomatis.
        </p>
      </div>
      <div class="flex flex-col items-center text-white">
        <h3 class="text-base pb-5">Follow Us</h3>
        <div class="grid grid-cols-4 gap-4 [&>*]:flex [&>*]:flex-row [&>*]:gap-2 [&>*]:justify-center [&>*]:items-center">
          <div>
            <a href={`https://www.${instagram}.com/${userig}`} class="flex flex-row gap-2 items-center">
              <Icon path="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3Z" primary="w-10 h-10 text-blue-600 hover:text-white hover:bg-blue-600 bg-white p-2 rounded-xl" />
            </a>
          </div>
          <div>
            <a href={`https://www.${facebook}.com/${userfb}`} class="flex flex-row gap-2 items-center">
            <Icon path="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" primary="w-10 h-10 text-blue-600 hover:text-white hover:bg-blue-600 bg-white p-2 rounded-xl" />
          </a>
          </div>
          <div>
            <a href="https://www.tiktok.com/@jejakbahagiaa" class="flex flex-row gap-2 items-center">
              <Icon path="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 10.692 6.33 6.33 0 0 0 10.857-4.424V8.687a8.182 8.182 0 0 0 4.773 1.526V6.79a4.831 4.831 0 0 1-1.003-.104z" primary="w-10 h-10 text-blue-600 hover:text-white hover:bg-blue-600 bg-white p-2 rounded-xl" />
            </a>
          </div>
          <div>
            <a href="https://wa.me/6281532094978?text=Hallo admin Jejak Bahagia, buat undangan dong!" class="flex flex-row items-center gap-2">
            <Icon path="M16.6 14c-.2-.1-1.5-.7-1.7-.8c-.2-.1-.4-.1-.6.1c-.2.2-.6.8-.8 1c-.1.2-.3.2-.5.1c-.7-.3-1.4-.7-2-1.2c-.5-.5-1-1.1-1.4-1.7c-.1-.2 0-.4.1-.5c.1-.1.2-.3.4-.4c.1-.1.2-.3.2-.4c.1-.1.1-.3 0-.4c-.1-.1-.6-1.3-.8-1.8c-.1-.7-.3-.7-.5-.7h-.5c-.2 0-.5.2-.6.3c-.6.6-.9 1.3-.9 2.1c.1.9.4 1.8 1 2.6c1.1 1.6 2.5 2.9 4.2 3.7c.5.2.9.4 1.4.5c.5.2 1 .2 1.6.1c.7-.1 1.3-.6 1.7-1.2c.2-.4.2-.8.1-1.2l-.4-.2m2.5-9.1C15.2 1 8.9 1 5 4.9c-3.2 3.2-3.8 8.1-1.6 12L2 22l5.3-1.4c1.5.8 3.1 1.2 4.7 1.2c5.5 0 9.9-4.4 9.9-9.9c.1-2.6-1-5.1-2.8-7m-2.7 14c-1.3.8-2.8 1.3-4.4 1.3c-1.5 0-2.9-.4-4.2-1.1l-.3-.2l-3.1.8l.8-3l-.2-.3c-2.4-4-1.2-9 2.7-11.5S16.6 3.7 19 7.5c2.4 3.9 1.3 9-2.6 11.4" primary="w-10 h-10 text-blue-600 hover:text-white hover:bg-blue-600 bg-white p-2 rounded-xl border-0 ring-0" />
            </a>
          </div>
        </div>
      </div>
      <div class="flex flex-col items-center md:items-start lg:items-center">
        <h3 class="text-base pb-5 text-white">Support Pembayaran</h3>
        <div class="grid grid-cols-3 gap-3 items-center relative justify-start text-white w-fit [&>*]:flex [&>*]:flex-row [&>*]:gap-2 [&>*]:justify-center [&>*]:items-center [&>*]:rounded-full [&>*]:relative [&>*]:w-10 [&>*]:h-10 [&>*]:bg-white hover:[&>*]:bg-blue-600">
          <div>
            <img src="/assets/bri.png" alt="Pembayaran" class="absolute max-w-6">
          </div>
          <div>
            <img src="/assets/sea.png" alt="Pembayaran" class="absolute max-w-6">
          </div>
          <div>
            <img src="/assets/gopay.png" alt="Pembayaran" class="absolute max-w-8">
          </div>
          <div>
            <img src="/assets/dana.png" alt="Pembayaran" class="absolute max-w-6">
          </div>
          <div>
            <img src="/assets/ovo.png" alt="Pembayaran" class="absolute max-w-8">
          </div>
          <div>
            <img src="/assets/shopee.png" alt="Pembayaran" class="absolute max-w-8">
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-1 mt-10 border-blue-40 text-center">
      <p class="text-white pt-5">Copyright © 2026 <a href="#" class="text-white">JejakBahagia</a> All Right Reserved</p>
    </div>
  </div>
</footer>
