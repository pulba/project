---
import Page from '../layouts/page.astro';
import '@fontsource/poppins';
import Icon from "../components/icon.astro"
const facebook = "facebook";
const userfb = "jejakbahagia02";
const instagram = "instagram";
const userig = "jejakbahagia_";
---

<Page title="Contact |" name="Contact" desc="Yukk!Lebih Dekat dengan Kami" subs="Lebih Dekat dengan Kami">
  <div class="flex flex-col md:flex-row justify-center gap-3 w-full max-w-screen-md mx-auto *:bg-blue-700 *:text-white *:p-2 *:flex *:flex-row *:items-center *:justify-between *:w-full *:rounded-md *:px-6 hover:*:text-blue-900">
    <a href={`https://www.${instagram}.com/${userig}`} class="group">
      <Icon path="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" primary="w-10 h-10 text-blue-700 bg-white p-2 rounded-full group-hover:text-white group-hover:bg-blue-900" />{userig}
    </a>
    <a href={`https://www.${facebook}.com/${userfb}`} class="group">
      <Icon path="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" primary="w-10 h-10 text-blue-700 bg-white p-2 rounded-full group-hover:text-white group-hover:bg-blue-900" />{userfb}
    </a>
    <a href="https://wa.me/6281532094978?text=Hallo kak, saya buat undangan dong!" class="group">
      <Icon path="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" primary="w-10 h-10 text-blue-700 bg-white p-2 rounded-full group-hover:text-white group-hover:bg-blue-900" />
      <p>+62 815-3209-4978</p>
      </a>
  </div>
</Page>
