---
import Page from "../../layouts/page.astro";
import Product from "../../layouts/product.astro";
type MarkdownModule = {
  metadata: {
    title?: string;
    number?: number;
    slug?: string;
    img?: { url?: string; alt?: string };
    link?: string;
    desc?: string;
    price?: string;
    unprice?: string;
  };
  default: any;
};

const loadFiles = async (files: Record<string, () => Promise<any>>) => {
  return await Promise.all(
    Object.entries(files).map(async ([path, resolver]) => {
      const post = await resolver();
      const metadata = post.frontmatter ?? post['frontmatter'] ?? {}; // fallback aman

      const slug = metadata.slug || path.split('/').pop()?.replace('.md', '') || '';

      return {
        frontmatter: metadata,
        slug,
        component: post.default
      };
    })
  );
};

// ✅ Gunakan string literal, TANPA `${}`
const natureFiles = import.meta.glob('../nature/*.md');
const adatFiles = import.meta.glob('../adat/*.md');
const floralFiles = import.meta.glob('../floral/*.md');
const popularFiles = import.meta.glob('../popular/*.md');

const [nature, adat, floral, popular] = await Promise.all([
  loadFiles(natureFiles),
  loadFiles(adatFiles),
  loadFiles(floralFiles),
  loadFiles(popularFiles),
]);



---

<Page title="Katalog Tema Adat |" name="Katalog Tema Adat" subs="Kumpulan undangan dengan tema adat tradisional.">
  <div class="mx-auto mt-5 w-full">
    <h2 class="text-center font-bold text-gray-700 mb-5 mt-12 text-3xl"> Foto Prewedding</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        adat
          .filter((post) => post.frontmatter.number !== undefined)
          .sort((a, b) => a.frontmatter.number - b.frontmatter.number)
          .slice(0, 10)
          .map((post) => (
            <Product
              primary="hidden"
              aspect="square"
              slug={post.frontmatter.slug || ""}
              link={post.frontmatter.link || ""}
              src={post.frontmatter.img?.url || ""}
              title={post.frontmatter.title || ""}
              alt={post.frontmatter.img?.alt || ""}
              desc={post.frontmatter.desc || ""}
              price={post.frontmatter.price || ""}
              unprice={post.frontmatter.unprice || ""}
              number={post.frontmatter.number || ""}
            />
          ))
      }
    </div>
  </div>
  <div class="mx-auto mt-5 w-full">
    <h2 class="text-center font-bold text-gray-700 mb-5 mt-12 text-3xl"> Tanpa Foto</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        adat
          .filter((post) => post.frontmatter.number !== undefined)
          .sort((a, b) => a.frontmatter.number - b.frontmatter.number)
          .slice(10, 20)
          .map((post) => (
            <Product
              primary="hidden"
              aspect="square"
              slug={post.frontmatter.slug || ""}
              link={post.frontmatter.link || ""}
              src={post.frontmatter.img?.url || ""}
              title={post.frontmatter.title || ""}
              alt={post.frontmatter.img?.alt || ""}
              desc={post.frontmatter.desc || ""}
              price={post.frontmatter.price || ""}
              unprice={post.frontmatter.unprice || ""}
              number={post.frontmatter.number || ""}
            />
          ))
      }
    </div>
  </div>
</Page>
