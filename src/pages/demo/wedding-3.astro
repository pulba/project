let { frontmatter } = Astro.props;

if (!frontmatter) {
  let data = {};
  data["title"] = "wedding-3";
  data["type"] = "Basic 01";
  data["desc"] = "wedding-3";
  data["countdown"] = "Jun 26, 2024 15:37:25";

  data["bgfs"] = "bg-amber-100";
