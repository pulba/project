  data["txth"] = "text-amber-900";

  data["bdr"] = "border-amber-800";
  data["from"] = "from-amber-100";
  data["before"] = "before:bg-black";

  data["cover"] = "/assets/img-10.webp";
  data["imgsc"] = "/assets/img-20.webp";
  data["bg"] = "/assets/dekor-24.webp";
  // Img kedua mempelai
  data["dekorfs"] = "/assets/dekor30.webp";
  data["dekorsc"] = "/assets/dekor31.webp";
  data["dekorth"] = "/assets/dekor28.webp";
  data["dekorfr"] = "/assets/dekor29.webp";
  data["dekorfv"] = "/assets/dekor26.webp";
  // Img kedua mempelai
  data["pm1"] = "/assets/img-27.webp";
  data["pm2"] = "/assets/img-26.webp";
  // Img kedua mempelai
  data["imgstory1"] = "/assets/img-5.webp";
  data["imgstory2"] = "/assets/img-6.webp";
  data["imgstory3"] = "/assets/img-7.webp";
  data["imgstory4"] = "/assets/img-8.webp";
  data["imgstory5"] = "/assets/img-9.webp";
  data["imgstory6"] = "/assets/img-10.webp";
  data["imgstory7"] = "/assets/img-11.webp";
  data["imgstory8"] = "/assets/img-12.webp";
  data["add1"] = "/assets/img-30.webp";
  data["add2"] = "/assets/img-4.webp";
  data["hidden"] = "hidden";

  //img story love
  data["imgstory9"] = "/assets/img-16.webp";
  data["imgstory10"] = "/assets/img-17.webp";
  data["imgstory11"] = "/assets/img-18.webp";

  // data mempelai
  data["male"] = "Remeo";
  data["fullmale"] = "Remeo Alexa";
  data["female"] = "Juliet";
  data["fullfemale"] = "Juliet Kapolo";
  data["music"] = "yovie-nuno-janji-suci";
  data["countdown"] = "June 5, 2025 15:37:25";

  data["childmale"] = "Putra kelima dari Pasangan";
  data["childfemale"] = "Putri Pertama dari Pasangan";
  data["parentmale"] = "Joko & Siti";
  data["parentfemale"] = "Bambang & Mulyani";
  data["instagrammale"] = "instagram";
  data["instagramfemale"] = "instagram";
  data["facebookmale"] = "facebook";
  data["facebookfemale"] = "facebook";
  data["citymale"] = "Palembang";
  data["cityfemale"] = "Makkasar";

  //bank
  data["logoml"] = "/assets/bri.png";
  data["bankml"] = "BRI";
  data["namebankml"] = "Remeo Alexa";
  data["numberbankml"] = "123456789";
  data["logofml"] = "/assets/bca.png";
  data["bankfml"] = "BCA";
  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["datefs"] = "Jumat, 05 Januari 2030";
  data["datesc"] = "Jumat, 05 Januari 2030";
  data["dateth"] = "Jumat, 05 Januari 2030";
  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
  data["addressfs"] = "Masjid Kampus UGM";
  data["addresssc"] = "Jogja Expo Center";
  data["addressth"] = "Rumah Mempelai Wanita";
  data["locationfs"] = "Rumah Mempelai Wanita";
  data["locationsc"] = "Rumah Mempelai Wanita";
  data["locationth"] = "Rumah Mempelai Wanita";
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["linkmaps"] =
    "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid";
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi"

  //story love
  data["storyfs"] =
    "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe.";
  data["storysc"] =
    "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet.";
  data["storyth"] =
    "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi.";

  data["quote"] =
    "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih.";

  frontmatter = data;
}
---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <input
    type="checkbox"
    id="toggle"
    class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear"
  />
  <section
    class=`animasi1 relative bg-cover bg-center overflow-hidden mx-auto peer-checked:h-0 before:content-[''] before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
    style={`background-image:url(${frontmatter.cover})`}
  >
    <Decor dekor1={frontmatter.dekorfs} dekor2={frontmatter.dekorfs} dekor3={frontmatter.dekorfs} dekor4={frontmatter.dekorfs} primary1="-rotate-90 block" primary2="block" primary3="rotate-180" primary4="block rotate-90 " dekorbt={frontmatter.dekorfs} dekorlf={frontmatter.dekorfs} dekorend={frontmatter.dekorfs} hidden1="block" hidden2="hidden" hidden3="hidden" hidden4="hidden *:w-8/12 *:sm:w-1/2 *:lg:w-1/3"/>
    <div
      class="container mx-auto relative z-50">
      <div class="h-screen flex flex-col justify-end items-center pb-20">
        <div class="">
          <h6
        class=`fade-left opacity-0 text-center text-sm md:text-xl mt-8 tracking-widest font-poppins`
      >
      THE WEDDING OF
      </h6>
      <div
        class=`flip-right opacity-0 flex gap-x-4 justify-center items-center *:font-nautigal *:font-thin *:max-[350px]:text-6xl *:text-7xl *:lg:text-9xl *:relative ${frontmatter.txth}`
      >
        <h2>{frontmatter.female}</h2>
        <span>&</span>
        <h2>{frontmatter.male}</h2>
      </div>
      <div class=`text-center ${frontmatter.txsc}`>
        <p class="fade-right opacity-0 mt-2">Kpd Bpk/Ibu/Saudara/i</p>
        <h4
          id="invite-name"
          class="fade-left opacity-0 text-xl font-bold my-3 capitalize"
        >
          <Namatamu /> nama tamu
        </h4>
        <label
          for="toggle"
          id="toaudio"
          class=`fade-right opacity-0 w-fit mx-auto mt-5 px-6 py-2 font-bold rounded-full relative flex gap-1 border ${frontmatter.txfs} ${frontmatter.bgth}`
          >Open Invitation
        </label>
      </div>
        </div>
      </div>
      
    </div>
  </section>
  <main id="myDIV" class="hidden peer-checked:block scroll-smooth">
    <section
      class=`animasi2 relative bg-cover bg-center overflow-hidden before:content-[''] before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from} ${frontmatter.hidden}`
      style={`background-image:url(${frontmatter.imgsc})`}
    >
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm"
      >
        <div class="-right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="-bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container px-6 py-20 mx-auto relative overflow-hidden">
        <div
          class=`h-screen flex flex-col gap-4 justify-center ${frontmatter.txsc}`
        >
          <h2
            class="fade-right opacity-0 font-nautigal w-full text-6xl min-[350px]:text-6xl md:text-7xl lg:text-9xl relative"
          >
            {frontmatter.female} & {frontmatter.male}
          </h2>
          <p class="fade-up opacity-0 sm:text-xl font-poppins font-bold">
            {frontmatter.datefs}
          </p>
          <p class="fade-up opacity-0 max-w-prose italic font-xs">
            {frontmatter.quote}
          </p>
        </div>
      </div>
    </section>
    <section
      class=`animasi3 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
      style={`background-image:url(${frontmatter.add1})`}
    >
      <div class="container py-32 px-6 mx-auto relative z-10">
        <div class=`text-center my-5 ${frontmatter.txsc}`>
          <h2
            class="fade-down opacity-0 text-xl md:text-2xl font-bold mt-5 md:mt-0 mb-3"
          >
            Countdown to
          </h2>
          <h1
            class="fade-right opacity-0 text-center font-nautigal text-5xl md:text-6xl lg:text-8xl"
          >
            Our Happy Day
          </h1>
        </div>
        <Countdown countdown={frontmatter.countdown} bgfs={frontmatter.bgth} txfs={frontmatter.txfs} />
      </div>
    </section>
    <section class=`animasi4 overflow-hidden relative ${frontmatter.bgsc}`>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm"
      >
        <div class="-right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="-bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 px-6 mx-auto relative z-50">
        <div
          class="flex flex-col lg:flex-row justify-center items-center gap-y-16 max-w-4xl mx-auto mt-5 *:text-center *:w-full *:flex *:flex-col *:items-center"
        >
          <div>
            <div
              class="fade-right opacity-0 relative flex items-center justify-center w-72"
            >
              <div
                class="w-56 h-56 bg-cover bg-center rounded-full relative"
                style={`background-image:url(${frontmatter.pm1})`}
              >
              </div>
              <img
                src=`${frontmatter.dekorsc}`
                alt="JejakBahagia"
                class="absolute"
              />
            </div>
            <h3
              class=`fade-down opacity-0 text-6xl md:text-7xl mt-6 font-nautigal ${frontmatter.txsc}`
            >
              {frontmatter.female}
            </h3>
            <div
              class=`fade-up opacity-0 font-poppins space-y-3 ${frontmatter.txsc}`
            >
              <div>
                <p
                  class=`text-xl font-medium border-b-2 w-max mx-auto ${frontmatter.bdr}`
                >
                  {frontmatter.fullfemale}
                </p>
                <p class="">{frontmatter.childfemale}</p>
                <p class=`font-medium ${frontmatter.txsc}`>
                  {frontmatter.parentfemale}
                </p>
                <div class="flex gap-3 text-center justify-center mt-4">
                  <a
                    href={`https://www.instagram.com/${frontmatter.instagramfemale}`}
                    class=`flex flex-row gap-2 p-1 items-center rounded-full ${frontmatter.txfs} ${frontmatter.bgth}`
                  >
                    <Icon path="mdi:instagram" primary="w-6 h-6" />
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div>
            <div
              class="fade-left opacity-0 relative flex items-center justify-center w-72"
            >
              <div
                class="w-56 h-56 bg-cover bg-center relative rounded-full"
                style={`background-image:url(${frontmatter.pm2})`}
              >
              </div>
              <img
                src=`${frontmatter.dekorsc}`
                alt="JejakBahagia"
                class="absolute"
              />
            </div>
            <h3
              class=`fade-down opacity-0 text-6xl md:text-7xl mt-6 font-nautigal ${frontmatter.txsc}`
            >
              {frontmatter.male}
            </h3>
            <div
              class=`fade-up opacity-0 font-poppins space-y-3 ${frontmatter.txsc}`
            >
              <div>
                <p
                  class=`text-xl font-medium border-b-2 w-max mx-auto ${frontmatter.bdr}`
                >
                  {frontmatter.fullmale}
                </p>
                <p class="">{frontmatter.childmale}</p>
                <p class=`font-medium ${frontmatter.txsc}`>
                  {frontmatter.parentmale}
                </p>
                <div class="flex gap-3 text-center justify-center mt-4">
                  <a
                    href={`https://www.instagram.com/${frontmatter.instagrammale}`}
                    class=`flex flex-row gap-2 p-1 items-center rounded-full ${frontmatter.txfs} ${frontmatter.bgth}`
                  >
                    <Icon path="mdi:instagram" primary="w-6 h-6" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class=`animasi5 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
      style={`background-image:url(${frontmatter.add2})`}
    >
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm"
      >
        <div class="-right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="-bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-12 px-6 mx-auto relative z-50">
        <div class="text-center mb-10">
          <h2
            class=`fade-down opacity-0 text-center font-nautigal text-5xl lg:text-8xl ${frontmatter.txsc}`
          >
            Tempat & Hari
          </h2>
        </div>
        <Card txfs={frontmatter.txfs} txth={frontmatter.txth} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
        <iframe
          src=`${frontmatter.linkmaps}`
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-3xl h-96 rounded-lg p-1 ${frontmatter.bgfs}`
        ></iframe>
      </div>
    </section>
    <section class=`animasi6 relative overflow-hidden ${frontmatter.bgsc}`>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm"
      >
        <div class="-right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="-bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <Gallery txsc={frontmatter.txsc} imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="nautigal" />
    </section>
    <section
      class=`animasi7 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
      style={`background-image:url(${frontmatter.add2})`}
    >
      <div class="container py-20 px-6 text-center mx-auto relative z-50">
        <div class="text-center my-10">
          <h2
            class=`fade-right opacity-0 text-5xl lg:text-8xl font-nautigal ${frontmatter.txsc}`
          >
            Wedding Gift
          </h2>
          <p
            class=`fade-left opacity-0 max-w-prose mx-auto mt-5 font-josefin ${frontmatter.txsc}`
          >
            Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan
            hadiah kepada kedua mempelai dapat mengirimkannya melalui :
          </p>
        </div>
        <Payment txfs={frontmatter.txfs} txth={frontmatter.txth} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
      </div>
    </section>
    <section class=`animasi8 overflow-hidden relative ${frontmatter.bgsc}`>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm"
      >
        <div class="-right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="-bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 z-50 px-6 text-center mx-auto relative">
        <div class:list={[`text-center my-5 mb-10 ${frontmatter.txsc}`]}>
          <h2 class="fade-right opacity-0 text-5xl md:text-8xl font-nautigal">
            Ucapan & Doa
          </h2>
          <h2 class="fade-right opacity-0 font-josefin">
            Please Confirm Your Attendance
          </h2>
        </div>

        <Rsvp bgfs={frontmatter.bgsc} bgsc={frontmatter.bgfs} txfs={frontmatter.txfs} txsc={frontmatter.txth} />
      </div>
      <Footerpost />
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg" />
    </audio>
    <Animation />
  </main>
</Noheader>
