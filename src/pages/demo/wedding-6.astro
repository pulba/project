---
import Noheader from "../../layouts/noheader.astro";
import { Icon } from "astro-icon/components";
import Namatamu from "../../layouts/namatamu.astro";
import Payment from "../../layouts/payment.astro";
import Rsvp from "../../layouts/rsvp.astro";
import Countdown from "../../layouts/countdown.astro";
import Footerpost from "../../layouts/footer-post.astro";
import Audio from "../../layouts/audio.astro";
import Animation from "../../layouts/animation.astro";
import Splide from "../../layouts/autoscroll.astro";
import Gallery from "../../layouts/gallery.astro";
import Card from '../../layouts/card.astro';

let { frontmatter, count } = Astro.props;

if (!frontmatter) {
  let data = {};
  data["title"] = "wedding-6";
  data["type"] = "Exlusive 03";
  data["desc"] = "wedding-6";
  data["countdown"] = "Jun 26, 2024 15:37:25";

  data["bgfs"] = "bg-red-100";
  data["bgsc"] = "bg-red-500";
  data["bgth"] = "bg-red-800";

  data["txfs"] = "text-red-100";
  data["txsc"] = "text-red-500";
  data["txth"] = "text-red-800";

  data["bdr"] = "border-red-500";
  data["from"] = "from-red-100";
  data["before"] = "before:bg-black";

  data["cover"] = "/assets/img-5.webp";
  data["imgsc"] = "/assets/img-6.webp";
  data["bg"] = "/assets/dekor-24.webp";
  // Img kedua mempelai
  data["dekorfs"] = "/assets/dekor7.webp";
  data["dekorsc"] = "/assets/dekor6.webp";
  data["dekorth"] = "/assets/dekor8.webp";
  // Img kedua mempelai
  data["pm1"] = "/assets/img-27.webp";
  data["pm2"] = "/assets/img-26.webp";
  // Img kedua mempelai
  data["imgstory1"] = "/assets/img-5.webp";
  data["imgstory2"] = "/assets/img-6.webp";
  data["imgstory3"] = "/assets/img-7.webp";
  data["imgstory4"] = "/assets/img-8.webp";
  data["imgstory5"] = "/assets/img-9.webp";
  data["imgstory6"] = "/assets/img-10.webp";
  data["imgstory7"] = "/assets/img-11.webp";
  data["imgstory8"] = "/assets/img-12.webp";
  data["add1"] = "/assets/img-29.webp";
  data["add2"] = "/assets/img-31.webp";

  //img story love
  data["imgstory9"] = "/assets/img-16.webp";
  data["imgstory10"] = "/assets/img-17.webp";
  data["imgstory11"] = "/assets/img-18.webp";

  // data mempelai
  data["male"] = "Remeo";
  data["fullmale"] = "Remeo Alexa";
  data["female"] = "Juliet";
  data["fullfemale"] = "Juliet Kapolo";
  data["music"] = "yovie-nuno-janji-suci";
  data["countdown"] = "June 5, 2025 15:37:25";

  data["childmale"] = "Putra kelima dari Pasangan";
  data["childfemale"] = "Putri Pertama dari Pasangan";
  data["parentmale"] = "Joko & Siti";
  data["parentfemale"] = "Bambang & Mulyani";
  data["instagrammale"] = "instagram";
  data["instagramfemale"] = "instagram";
  data["facebookmale"] = "facebook";
  data["facebookfemale"] = "facebook";
  data["citymale"] = "Palembang";
  data["cityfemale"] = "Makkasar";

  //bank
  data["logoml"] = "/assets/bri.png";
  data["bankml"] = "BRI";
  data["namebankml"] = "Remeo Alexa";
  data["numberbankml"] = "123456789";
  data["logofml"] = "/assets/bca.png";
  data["bankfml"] = "BCA";
  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["datefs"] = "Jumat, 05 Januari 2030";
  data["datesc"] = "Jumat, 05 Januari 2030";
  data["dateth"] = "Jumat, 05 Januari 2030";
  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
  data["addressfs"] = "Masjid Kampus UGM";
  data["addresssc"] = "Jogja Expo Center";
  data["addressth"] = "Rumah Mempelai Wanita";
  data["locationfs"] = "Rumah Mempelai Wanita";
  data["locationsc"] = "Rumah Mempelai Wanita";
  data["locationth"] = "Rumah Mempelai Wanita";
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["linkmaps"] =
    "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid";
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi"

  //story love
  data["storyfs"] =
    "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe.";
  data["storysc"] =
    "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet.";
  data["storyth"] =
    "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi.";

  data["quote"] =
    "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih.";

  frontmatter = data;
}
---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <input
    type="checkbox"
    id="toggle"
    class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear"
  />
  <section
    class=`animasi1 relative h-screen bg-cover bg-center overflow-hidden flex items-center peer-checked:h-0 peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear peer-checked:delay-500 before:content-[''] before:bg-gradient-to-t ${frontmatter.bgth} before:to-transparent before:inset-0 before:bg-cover before:absolute`
    style={`background-image:url(${frontmatter.cover})`}
  >
    <div
      class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
    >
      <div class="fade-down opacity-0">
        <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
      </div>
      <div class="fade-up opacity-0 right-0 top-0">
        <img
          src=`${frontmatter.dekorfs}`
          class="right-0 top-0"
          alt="JejakBahagia"
        />
      </div>
    </div>
    <div class="container mx-auto px-6 relative z-50">
      <div
        class=`h-screen py-12 flex flex-col justify-between items-center relative overflow-hidden text-center ${frontmatter.txfs}`
      >
        <p class="fade-right opacity-0 text-xl md:text-2xl">The Wedding of</p>
        <div
          class="flip-down opacity-0 text-center w-screen flex flex-col items-center justify-center"
        >
          <h1
            class=`w-full text-center font-alex text-center text-6xl md:text-8xl ${frontmatter.txfs}`
          >
            {frontmatter.female}
            <br /> & <br />
            {frontmatter.male}
          </h1>
        </div>
        <div class="fade-left opacity-0 text-white text-center">
          <p class="font-kaushan text-xs">Kpd Bpk/Ibu/Saudara/i</p>
          <h4 id="invite-name" class="text-2xl font-kaushan capitalize">
            <Namatamu /> nama tamu
          </h4>
          <p class="font-kaushan text-md">di Tempat</p>
        </div>
        <label
          for="toggle"
          id="toaudio"
          class=`flip-up opacity-0 mt-5 px-6 py-2 relative rounded-full font-kaushan flex gap-1 ${frontmatter.bgsc} ${frontmatter.txfs}`
          ><Icon name="mdi:love-letter" class="w-5 h-5" />Open Invitation
        </label>
      </div>
    </div>
  </section>
  <main id="myDIV" class=`hidden peer-checked:block ${frontmatter.bgth}`>
    <section
      class="animasi2 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}
    >
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container px-6 mx-auto relative overflow-hidden">
        <div
          class=`text-center h-screen flex flex-col items-center justify-center   font-kaushan max-w-prose mx-auto ${frontmatter.txfs}`
        >
          <p class="fade-up opacity-0">
            <span class="italic">Assalamu'alaikum Wr Wb</span>
            <br />
            Tanpa mengurangi rasa hormat, kami bermaksud mengundang Bapak/Ibu/Saudara/i
            pada acara resepsi pernikahan anak kami
          </p>
        </div>
      </div>
    </section>
    <section
      class="animasi3 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}
    >
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container mx-auto px-6 py-20 relative">
        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-y-12 md:gap-y-40 gap-x-16 max-w-4xl mx-auto mt-12"
        >
          <div class="relative items-center justify-center mx-auto w-full">
            <div
              class="text-center overflow-hidden flex items-center justify-center md:items-end md:justify-end"
            >
              <div
                class="fade-right relative flex items-center justify-center w-72"
              >
                <div
                  class=`w-56 h-64 bg-cover bg-center relative rounded-t-full border-4 ${frontmatter.bdr}`
                  style={`background-image:url('${frontmatter.pm1}')`}
                >
                </div>
              </div>
            </div>
          </div>
          <div class="relative text-center sm:text-start mx-auto w-full">
            <h3
              class=`fade-down opacity-0 text-6xl mt-6 font-great ${frontmatter.txfs}`
            >
              {frontmatter.female}
            </h3>
            <div
              class=`fade-up opacity-0 font-kaushan space-y-3 ${frontmatter.txfs}`
            >
              <p
                class=`text-xl font-bold mx-auto sm:mx-0 border-b w-max ${frontmatter.bdr}`
              >
                {frontmatter.fullfemale}
              </p>
              <p class="text-lg">{frontmatter.childfemale}</p>
              <p class=`text-lg font-bold`>
                {frontmatter.parentfemale}
              </p>
              <p>{frontmatter.cityfemale}</p>
              <a
                href={`https://www.instagram.com/${frontmatter.instagramfemale}`}
                class="flex flex-row gap-2 items-center justify-center sm:justify-start"
              >
                <Icon
                  name="mdi:instagram"
                  class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgth}`
                />
              </a>
            </div>
          </div>
          <div
            class="relative items-center justify-center mx-auto w-full sm:order-last"
          >
            <div
              class="text-center overflow-hidden flex items-center justify-center md:items-start md:justify-start"
            >
              <div
                class="fade-right relative flex items-center justify-center w-72"
              >
                <div
                  class=`w-56 h-64 bg-cover bg-center relative rounded-t-full border-4 ${frontmatter.bdr}`
                  style={`background-image:url('${frontmatter.pm2}')`}
                >
                </div>
              </div>
            </div>
          </div>
          <div class="relative text-center sm:text-start mx-auto w-full">
            <h3
              class=`fade-down opacity-0 text-6xl mt-6 font-great sm:text-right ${frontmatter.txfs}`
            >
              {frontmatter.male}
            </h3>
            <div
              class=`fade-up opacity-0 font-kaushan space-y-3 sm:text-end ${frontmatter.txfs}`
            >
              <p
                class=`text-xl mx-auto sm:mx-0 font-bold border-b w-max ${frontmatter.bdr} sm:ml-auto sm:text-right`
              >
                {frontmatter.fullmale}
              </p>
              <p class="text-lg">{frontmatter.childmale}</p>
              <p class="text-lg font-bold">
                {frontmatter.parentmale}
              </p>
              <p>{frontmatter.citymale}</p>
              <a
                href={`https://www.instagram.com/${frontmatter.instagrammale}`}
                class="flex flex-row gap-2 items-center justify-center sm:justify-end"
              >
                <Icon
                  name="mdi:instagram"
                  class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgth}`
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class=`animasi4 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-[''] before:bg-gradient-to-b ${frontmatter.from} before:to-transparent before:inset-0 before:bg-cover before:absolute`
      style={`background-image:url(${frontmatter.add1})`}
    >
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-32 mx-auto relative z-10">
        <div class=`text-center my-5 ${frontmatter.txfs}`>
          <h2 class="fade-right opacity-0 font-kaushan">Save The Date</h2>
          <h1
            class="fade-left opacity-0 text-center font-alex text-5xl md:text-6xl"
          >
            Our Happy Day
          </h1>
        </div>
        <div
          data-count={frontmatter.countdown}
          id="timer"
          class=`fade-up opacity-0 grid grid-cols-2 md:grid-cols-4 gap-y-8 justify-center text-center items-center mt-20 sm:px-20 max-w-3xl mx-auto [&>*]:text-center [&>*]:text-4xl [&>*]:sm:text-6xl [&>*]:font-medium [&>*]:p-1 ${frontmatter.txfs}`
        >
        </div>
      </div>
    </section>
    <section
      class="animasi5 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}
    >
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container mx-auto py-20 px-6">
        <div class=`text-center my-5 mb-10 ${frontmatter.txfs}`>
          <h2 class="fade-right opacity-0 font-kaushan">Where & When</h2>
          <h1
            class="fade-left opacity-0 text-center font-alex text-5xl md:text-6xl"
          >
            Wedding Day
          </h1>
        </div>
        <Card txfs={frontmatter.txfs} txth={frontmatter.txfs} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
        <iframe
          src=`${frontmatter.linkmaps}`
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-3xl h-96 rounded-lg p-1 ${frontmatter.bgth}`
        ></iframe>
      </div>
    </section>
    <section
      class="animasi6 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}
    >
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <Gallery txsc={frontmatter.txsc}  imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="nautigal" />
    </section>
    <section
      class="animasi7 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}>
      <div class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 px-6 text-center mx-auto relative">
        <div class:list={[`${frontmatter.txfs}`]}>
          <h2 class="fade-right opacity-0 text-5xl md:text-6xl font-alex">
            Wedding Gift
          </h2>
          <p
            class="fade-left opacity-0 max-w-md mx-auto mt-5 font-kaushan"
          >
          Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan hadiah kepada kedua mempelai dapat mengirimkannya melalui :
          </p>
        </div>
        <Payment txfs={frontmatter.txfs} txth={frontmatter.txfs} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
      </div>
    </section>
    <section
      class="animasi8 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}>
      <div class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 z-50 px-6 text-center mx-auto relative">
        <div class:list={[`text-center my-5 mb-10 ${frontmatter.txfs}`]}>
          <h2 class="fade-right opacity-0 text-5xl md:text-6xl font-alex">
            Ucapan & Doa
          </h2>
          <h2 class="fade-right opacity-0 font-kaushan">
            Please Confirm Your Attendance
          </h2>
        </div>

        <Rsvp color="gray-600" />
      </div>
      <Footerpost />
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg" />
    </audio>
    <Animation />
    <Splide />
    <Countdown count={frontmatter.countdown} />
  </main>
</Noheader>
