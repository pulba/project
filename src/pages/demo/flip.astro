  <div id="audioContainer" class="hidden">
    <Audio txfs={frontmatter.txfs} bgth={frontmatter.bgth} bdr={frontmatter.bdr} />
  </div>
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg" />
    </audio>
    <script>
      const book = document.querySelector('.book');
      const openButton = document.getElementById('openInvitation');
      const prevButton = document.getElementById('prevButton');
      const nextButton = document.getElementById('nextButton');
      const audio = document.getElementById('myAudio');
      const audioContainer = document.getElementById('audioContainer');
      const pages = Array.from(book.querySelectorAll('.page'));
      let currentPage = pages.length - 1;

      function updateButtons() {
          // Reset semua tombol dan container audio ke hidden
          openButton.classList.add('hidden');
          prevButton.classList.add('hidden');
          nextButton.classList.add('hidden');
          audioContainer.classList.add('hidden');

          // Logika berdasarkan currentPage
          if (currentPage === pages.length - 1) {
              // Halaman pertama: hanya tampilkan "Buka Undangan"
              openButton.classList.remove('hidden');
          } else {
              // Halaman kedua dan seterusnya: tampilkan "Previous", "Next", dan ikon audio
              prevButton.classList.remove('hidden');
              if (currentPage > 0) {
                  nextButton.classList.remove('hidden');
              }
              audioContainer.classList.remove('hidden');
          }
      }

      function flipPage(index, flip) {
          const page = pages[index];
          if (flip) {
              page.classList.add('flipped');
              page.addEventListener('transitionend', () => {
                  if (!page.classList.contains('flipped')) return;
                  updateButtons();
              }, { once: true });
          } else {
              page.classList.remove('flipped');
              page.addEventListener('transitionend', () => {
                  if (page.classList.contains('flipped')) return;
                  updateButtons();
              }, { once: true });
          }
      }

      openButton.addEventListener('click', () => {
          if (currentPage > 0) {
              flipPage(currentPage, true);
              currentPage--;
              // Mulai putar audio saat ada interaksi pengguna
              if (audio) {
                  audio.play().catch(error => console.log('Pemutaran audio gagal:', error));
              }
          }
      });

      nextButton.addEventListener('click', () => {
          if (currentPage > 0) {
              flipPage(currentPage, true);
              currentPage--;
          }
      });

      prevButton.addEventListener('click', () => {
          if (currentPage < pages.length - 1) {
              currentPage++;
              flipPage(currentPage, false);
          }
      });

      // Deteksi gerakan swipe
      let touchStartX = 0;
      let touchEndX = 0;

      function handleGesture() {
          const swipeThreshold = 50;
          const diffX = touchStartX - touchEndX;
          if (diffX > swipeThreshold) {
              if (currentPage > 0) {
                  flipPage(currentPage, true);
                  currentPage--;
              }
          } else if (diffX < -swipeThreshold) {
              if (currentPage < pages.length - 1) {
                  currentPage++;
                  flipPage(currentPage, false);
              }
          }
      }

      book.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].clientX;
      });

      book.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].clientX;
          handleGesture();
      });

      // Inisialisasi tombol saat halaman dimuat
      document.addEventListener('DOMContentLoaded', updateButtons);


      //rsvp
      import Alpine from "alpinejs";

    document.addEventListener("alpine:init", function () {
      Alpine.data("Rsvp", function () {
        return {
          username: "",
          message: "",
          present: 0,

          data: [],
          hasData: false,

          getRsvp() {
            var data = {
              url: window.location.pathname,
            };
            var query = new URLSearchParams(data).toString();

            var _this = this;

            fetch("/api/rsvp-get?" + query, {
              method: "GET",
            })
              .then(function (resp) {
                return resp.json();
              })
              .then(function (data) {
                _this.data = data;

                if (data.length > 0) {
                  _this.hasData = true;
                }

                (_this.username = ""),
                  (_this.message = ""),
                  (_this.present = 1),
                  console.log(data);
              })
              .catch(function (err) {
                console.log(err);
              });
          },

          sendRsvp() {
            var data = {
              name: this.username,
              content: this.message,
              present: this.present,
              url: window.location.pathname,
            };

            var query = new URLSearchParams(data).toString();

            var _this = this;

            fetch("/api/rsvp-send?" + query, {
              method: "GET",
            })
              .then(function (resp) {
                if (resp.ok) {
                  _this.getRsvp();

                  console.log(resp.ok);

                  setTimeout(() => {
                    document.getElementById("output").scrollIntoView({
                      behavior: "smooth",
                      block: "start", 
                      inline: "nearest",
                    });
                  }, 100);
                }
              })
              .catch(function (err) {
                console.log(err);
              });
          },

          init() {
            this.getRsvp();
          },
        };
      });
    });
      
  </script>
