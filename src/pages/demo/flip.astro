  data["styleBs"] = "rounded-full";
  data["important"] = "!flex-none !w-fit lg:!w-full px-3 [&>div>div]:max-[600px]:justify-start [&>div]:w-full [&>div>p]:text-sm [&>img]:!w-max";
  data["animation"] = "!opacity-100";
  data["brideflex"] = "!flex-row";
  data["primary"] = "block";
  data["font"] = "font-great";
  data["button"] = "rounded-full px-4 py-2";

  data["cover"] = "/assets/img-12.webp";
  data["cvrsc"] = '/assets/img-35.webp';
  data["cvrth"] = '/assets/img-36.webp';
  data["cvrfr"] = '/assets/img-38.webp';
  data["cvrfv"] = '/assets/img-38.webp';
  // Img kedua mempelai
  data["dekorsc"] = "/assets/dekor22.webp";
  data["dekorsc"] = "/assets/dekor23.webp";
  data["dekorth"] = "/assets/dekor24.webp";
  data["dekorfr"] = '/assets/dekor64.webp'
  data["dekorfv"] = '/assets/dekor65.webp'
  data["dekorsx"] = '/assets/dekor67.webp'
  // Img kedua mempelai
  data["pm1"] = "/assets/img-11.webp";
  data["pm2"] = "/assets/img-12.webp";
  // Img kedua mempelai
  data["imgstory1"] = "/assets/img-5.webp";
  data["imgstory2"] = "/assets/img-6.webp";
  data["imgstory3"] = "/assets/img-7.webp";
  data["imgstory4"] = "/assets/img-8.webp";
  data["imgstory5"] = "/assets/img-9.webp";
  data["imgstory6"] = "/assets/img-10.webp";
  data["imgstory7"] = "/assets/img-11.webp";
  data["imgstory8"] = "/assets/img-12.webp";

  //img story love
  data["imgstory9"] = "/assets/img-16.webp";
  data["imgstory10"] = "/assets/img-17.webp";
  data["imgstory11"] = "/assets/img-18.webp";

  // data mempelai
  data["male"] = "Remeo";
  data["fullmale"] = "Remeo Alexa";
  data["female"] = "Juliet";
  data["fullfemale"] = "Juliet Kapolo";
  data["music"] = "Lagu Pernikahan Kita";
  data["countdown"] = "June 5, 2025 15:37:25";

  data["childmale"] = "Putra kelima dari Pasangan";
  data["childfemale"] = "Putri Pertama dari Pasangan";
  data["parentmale"] = "Joko & Siti";
  data["parentfemale"] = "Bambang & Mulyani";
  data["instagrammale"] = "instagram";
  data["instagramfemale"] = "instagram";
  
  //bank
  data["logoml"] = "/assets/bri.png";
  data["bankml"] = "BRI";
  data["namebankml"] = "Remeo Alexa";
  data["numberbankml"] = "123456789";
  data["logofml"] = "/assets/bca.png";
  data["bankfml"] = "BCA";
  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["datefs"] = "Jumat, 05 Januari 2030";
  data["datesc"] = "Jumat, 05 Januari 2030";
  data["dateth"] = "Jumat, 05 Januari 2030";
  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
  data["addressfs"] = "Masjid Kampus UGM";
  data["addresssc"] = "Jogja Expo Center";
  data["addressth"] = "Rumah Mempelai Wanita";
  data["locationfs"] = "Rumah Mempelai Wanita";
  data["locationsc"] = "Rumah Mempelai Wanita";
  data["locationth"] = "Rumah Mempelai Wanita";
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["linkmaps"] ="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid";
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi";

  
//story love
data["storyfs"] = "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe."
  data["storysc"] = "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet."
  data["storyth"] = "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi."
  
  data["quote"] = "وَمِنْ اٰيٰتِهٖٓ اَنْ خَلَقَ لَكُمْ مِّنْ اَنْفُسِكُمْ اَزْوَاجًا لِّتَسْكُنُوْٓا اِلَيْهَا وَجَعَلَ بَيْنَكُمْمَّوَدَّةً وَّرَحْمَةًۗ اِنَّ فِيْ ذٰلِكَ لَاٰيٰتٍ لِّقَوْمٍ يَّتَفَكَّرُوْنَ"
  data["atribusi"] = " (Qs. Ar-Rum : 21)";
  data["kutipan"] = "Dalam tafsir Buya Hamka, Surah Ar-Ruum ayat 21 menegaskan bahwa penciptaan laki-laki dan perempuan berpasangan merupakan satu di antara tanda kebesaran Allah. Diikat dalam simpul tali cinta (mawaddah)  yang saling merindukan dan kasih sayang (rahmah) yang terus mendalam tumbuh hingga menua sampai maut memisahkan.";

  frontmatter = data;
}

---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <section>
    <div class="container flex flex-col justify-center items-center p-2">
      <div x-data="Rsvp" class="book relative w-full h-[90vh] max-w-sm *:w-full *:h-full *:overflow-hidden *:rounded-l-lg" style="perspective: 1000px;">
        <div class=`page absolute p-6 flex flex-col justify- items-center gap-6 bg-cover bg-center before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from} ${frontmatter.bgfs}`
        style={`background-image:url(${frontmatter.cvrfv})`}>
          <div class="relative flex flex-col items-center w-full">
            <h4 class=`text-sm text-center uppercase ${frontmatter.txfs}`>Kami Yang Berbahagia</h4>
            <h2 class=`text-center !text-4xl drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.8)] ${frontmatter.txfs} ${frontmatter.font}`>{frontmatter.female} <span class="text-2xl">&</span> {frontmatter.male}</h2>
          </div>
          <p class=`relative text-center text-sm font-bold italic max-w-xs w-full ${frontmatter.txfs}`>{frontmatter.kutipan}</p>
        </div>
        <div class=`page absolute px-6 bg-cover bg-center before:content-[''] before:opacity-70 before:inset-0 before:bg-cover before:absolute *:relative ${frontmatter.before} ${frontmatter.bgfs}` style={`background-image:url(${frontmatter.cvrth})`}
          x-show="hasData">
          <h6 class=`${frontmatter.txth} ${frontmatter.font} !text-5xl mt-5`>
            Seutas <span class="font-poppins">Do'a</span> 
          </h6>
            <div id="output" class=`w-full max-w-xl mx-auto px-2 overflow-auto space-y-6 overflow-y-scroll h-[70vh]`>
              <template x-for="user in data" :key="user.id">
                <div
                  class=`${frontmatter.bgfs} flex flex-col leading-1.5 w-full p-4 border-gray-200 rounded-e-xl rounded-es-xl border border-gray-400 font-poppins shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)]`
                  id="display">
                  <div class="flex items-center justify-between">
                    <p
                      x-text="user.name"
                      class=`${frontmatter.txth} text-md font-semibold capitalize`>
                    </p>
                    <p
                      x-text="user.present ? 'Hadir' : 'Tidak Hadir'"
                      x-bind:class=`{
                        '${frontmatter.txfs} ${frontmatter.bgth}': user.present,
                        '${frontmatter.txth} ${frontmatter.bgsc}': !user.present
                      }`
                      class="text-sm font-normal px-3 py-1 rounded-full">
                    </p>
                  </div>
                  <p
                    x-text="user.content"
                    class=`${frontmatter.txth} text-base italic text-left py-5 text-gray-800/50 font-medium`>
                  </p>
                </div>
              </template>
            </div>
          </div>
        <div class=`page absolute px-6 ${frontmatter.bgfs} bg-cover bg-center before:content-[''] before:opacity-70 before:inset-0 before:bg-cover before:absolute *:relative ${frontmatter.before}` style={`background-image:url(${frontmatter.cvrsc})`}>
          <h6 class=`${frontmatter.txth} ${frontmatter.font} mt-5 text-end`>
            <span class="font-poppins text-3xl">Pesan</span> Bahagia 
          </h6>
         <form @submit.prevent="sendRsvp" class=`w-full max-w-xl px-4 py-8 sm:px-12 mx-auto mb-10 rounded-md shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] border ${frontmatter.animation} ${frontmatter.bgsc}`>
          <div
            class="mt-4 space-y-8 [&>*]:font-poppins [&>*]:text-left [&>*]:text-gray-800/50 [&>*]:space-y-2">
            <div>
              <label for="username" class=`${frontmatter.txth}`>Nama</label>
              <input
                value=""
                required
                id="username"
                type="text"
                name="name"
                placeholder="Tiara Anggraini"
                class=`block w-full px-4 py-3 text-gray-700 bg-white border border-gray-200 rounded-md focus:outline-none`
                x-model="username"
              />
            </div>
            <div>
              <label for="message" class=`${frontmatter.txth}`>Ucapan</label>
              <textarea
                id="message"
                required
                rows="4"
                name="content"
                class="block p-5 w-full text-sm text-gray-800 bg-gray-50 rounded-lg border border-gray-300 focus:outline-none"
                placeholder="Selamat untuk acaranya..."
                x-model="message"></textarea>
            </div>
            <div>
              <div class="flex items-center mb-4 font-poppins">
                <input
                  checked
                  id="default-radio-1"
                  name="present"
                  type="radio"
                  value="1"
                  name="default-radio"
                  class=`radio w-4 h-4 ${frontmatter.txfs}`
                  x-model="present"
                />
                <label
                  for="default-radio-1"
                  class=`ms-2 text-base font-medium ${frontmatter.txth}`>Hadir</label
                >
              </div>
              <div class="flex items-center font-poppins">
                <input
                  id="default-radio-2"
                  name="present"
                  type="radio"
                  value="0"
                  name="default-radio"
                  class=`radio w-4 h-4 ${frontmatter.txth}`
                  x-model="present"
                />
                <label
                  for="default-radio-2"
                  class=`ms-2 text-base font-medium ${frontmatter.txth}`
                  >Tidak Hadir</label
                >
              </div>
            </div>

            <div class="flex justify-center min-[400px]:justify-end mt-6">
              <button
                id="send"
                type="submit"
                class=`${frontmatter.bgth} ${frontmatter.txfs} px-4 py-2 relative rounded-full border font-poppins flex gap-1 transition-all duration-700 ease-linear`
                >Kirim Pesan</button
              >
            </div>
          </div>
        </form>
        </div>
        <div class=`page absolute bg-cover bg-center before:content-[''] before:opacity-70 before:inset-0 before:bg-cover before:absolute *:relative ${frontmatter.before} ${frontmatter.bgfs}` style={`background-image:url(${frontmatter.cvrfr})`}>
          <h5 class=`${frontmatter.txth} ${frontmatter.font} text-center mt-6`>Kado Cinta</h5>
          <div class="px-4 mt-6">
            <BankCard logo={frontmatter.logoml} name={frontmatter.namebankml} number={frontmatter.numberbankml} classNames={`flip-left *:!z-0 bg-gradient-to-t h-max max-w-screen-xs mx-auto *:overflow-hidden *:mx-auto *:w-full *:h-full *:max-w-xs rounded-2xl border-[1px] shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${frontmatter.animation} ${frontmatter.from} ${frontmatter.to} ${frontmatter.txth}`}/>
          <BankCard logo={frontmatter.logoml} name={frontmatter.namebankml} number={frontmatter.numberbankml} classNames={`flip-left *:!z-0 bg-gradient-to-t h-max max-w-screen-xs mx-auto *:overflow-hidden mt-5 *:mx-auto *:w-full *:h-full *:max-w-xs rounded-2xl border-[1px] shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${frontmatter.animation} ${frontmatter.from} ${frontmatter.to} ${frontmatter.txth}`}/>
          </div>
        </div>
        <div class=`page absolute px-6 bg-cover bg-center before:content-[''] before:opacity-75 before:inset-0 before:bg-cover before:absolute ${frontmatter.before} ${frontmatter.bgfs}` style={`background-image:url(${frontmatter.cvrfr})`}>
            <h5 class=`${frontmatter.txth} ${frontmatter.font} relative`>Skenario <br> <span class="font-poppins text-2xl">Terindah</span> </h5>
            <div class="relative p-4 flex flex-col gap-y-8 *:border-l-4 *:relative *:pl-2 *:rounded-md">
              <div class=`${frontmatter.bdr}`>
                <h2 class=`${frontmatter.font} ${frontmatter.txth} absolute top-0 rotate-90 translate-y-12 -translate-x-[5.5rem] !text-2xl`>Pertemuan</h2>
                <p class=`text-xs ${frontmatter.txth}`>
                  {frontmatter.storyfs} 
                </p>
              </div>
              <div class=`${frontmatter.bdr}`>
                <h2 class=`${frontmatter.font} ${frontmatter.txth} absolute top-0 rotate-90 translate-y-6 -translate-x-20 !text-2xl`>Lamaran</h2>
                <p class=`text-xs ${frontmatter.txth}`>
                  {frontmatter.storysc} 
                </p>
              </div>
              <div class=`${frontmatter.bdr}`>
                <h2 class=`${frontmatter.font} ${frontmatter.txth} absolute top-0 rotate-90 translate-y-12 -translate-x-20 !text-2xl`>Menikah</h2>
                <p class=`text-xs ${frontmatter.txth}`>
                  {frontmatter.storyth} 
                </p>
              </div>
          </div>
        </div>
        <div class=`page absolute p-6 ${frontmatter.display} ${frontmatter.bgfs}`>
            <h5 class=` ${frontmatter.txth}  text-center !text-3xl w-max `>Potret <br><span class=`${frontmatter.font}`>Perjalanan</span></h5>
            <div class="columns-2 gap-2 space-y-2">
                <img class="aspect-video object-cover object-center rounded-lg" src=`${frontmatter.imgstory1}` alt="">
                <img class="aspect-square object-cover object-center rounded-lg" src=`${frontmatter.imgstory2}` alt="">
                <img class="aspect-video object-cover object-center rounded-lg" src=`${frontmatter.imgstory3}` alt="">
                <img class="aspect-square object-cover object-center rounded-lg" src=`${frontmatter.imgstory4}` alt="">
                <img class="aspect-square object-cover object-center rounded-lg" src=`${frontmatter.imgstory5}` alt="">
                <img class="aspect-video object-cover object-center rounded-lg" src=`${frontmatter.imgstory6}` alt="">
                <img class="aspect-square object-cover object-center rounded-lg" src=`${frontmatter.imgstory7}` alt="">
                <img class="aspect-video object-cover object-center rounded-lg" src=`${frontmatter.imgstory8}` alt="">
              </div>
        </div>
        <div class=`page absolute *:relative p-2 bg-cover bg-center ${frontmatter.bgfs}`>
          <h5 class=`${frontmatter.txth} p-2 font-poppins !text-2xl text-center`> <span class=`${frontmatter.font}`>Jalan</span> <br> Menuju Halal</h5>
          <iframe src=`${frontmatter.linkmaps}` frameborder="0" height="350" width="90%" class=`opacity-75 mx-auto drop-shadow-[0.0px_4.0px_6.0px_rgba(0,0,0,0.35)] rounded-xl mb-5 border-4 ${frontmatter.bdr}`></iframe>
          <Button href={frontmatter.mapsfs} button={frontmatter.button} txfs={frontmatter.txth} bgth={frontmatter.bgfs} title="Klik Disini" path="M19.527 4.799c1.212 2.608.937 5.678-.405 8.173c-1.101 2.047-2.744 3.74-4.098 5.614c-.619.858-1.244 1.75-1.669 2.727c-.141.325-.263.658-.383.992c-.121.333-.224.673-.34 1.008c-.109.314-.236.684-.627.687h-.007c-.466-.001-.579-.53-.695-.887c-.284-.874-.581-1.713-1.019-2.525c-.51-.944-1.145-1.817-1.79-2.671L19.527 4.799zM8.545 7.705l-3.959 4.707c.724 1.54 1.821 2.863 2.871 4.18c.247.31.494.622.737.936l4.984-5.925l-.029.01c-1.741.601-3.691-.291-4.392-1.987a3.377 3.377 0 0 1-.209-.716c-.063-.437-.077-.761-.004-1.198l.001-.007zM5.492 3.149l-.003.004c-1.947 2.466-2.281 5.88-1.117 8.77l4.785-5.689l-.058-.05l-3.607-3.035zM14.661.436l-3.838 4.563a.295.295 0 0 1 .027-.01c1.6-.551 3.403.15 4.22 1.626c.176.319.323.683.377 1.045c.068.446.085.773.012 1.22l-.003.016l3.836-4.561A8.382 8.382 0 0 0 14.67.439l-.009-.003zM9.466 5.868L14.162.285l-.047-.012A8.31 8.31 0 0 0 11.986 0a8.439 8.439 0 0 0-6.169 2.766l-.016.018l3.665 3.084z" primary="w-4 h-4"></Button>
        </div>
        <div class=`page absolute bg-cover bg-center before:content-[''] before:opacity-75 before:inset-0 before:bg-cover before:absolute ${frontmatter.before} ${frontmatter.bgfs}` style={`background-image:url(${frontmatter.cvrth})`}>
          <h5 class=`${frontmatter.txth} relative text-center mt-12 font-poppins !text-xl`>Tandai Hari <br> <span class=`${frontmatter.font}`>Bahagia Kami</span> </h5>
            <div class="relative p-4 flex flex-col space-y-6">
                <div class="flex flex-row gap-2">
                    <p class=`text-4xl font-bold ${frontmatter.txth}`>01</p>
                    <div class=`pl-2 border-l-2 flex flex-col gap-y-3 ${frontmatter.bdr}`>
                        <h2 class=`${frontmatter.font} ${frontmatter.txth} !text-2xl`>{frontmatter.akad}</h2>
                      <small class=`${frontmatter.txth}`>
                        Momen sakral akad nikah akan diselenggarakan pada hari <strong>{frontmatter.datefs}</strong>, dimulai pukul <strong>{frontmatter.timefs}</strong> . Acara ini akan berlangsung di <strong>{frontmatter.locationfs}</strong> yang penuh kehangatan, yaitu di <strong>{frontmatter.addressfs}</strong>. 
                      </small>
                      </div>
                  </div>
                <div class="flex flex-row gap-2">
                    <p class=`text-4xl font-bold order-last ${frontmatter.txth}`>02</p>
                      <div class=`pr-2 border-r-2 flex flex-col gap-y-3 order-first text-right ${frontmatter.bdr}`>
                        <h2 class=`${frontmatter.font} ${frontmatter.txth} !text-2xl`>{frontmatter.resepsi}</h2>
                      <small class=`${frontmatter.txth}`>
                        Momen sakral akad nikah akan diselenggarakan pada hari <strong>{frontmatter.datesc}</strong>, dimulai pukul <strong>{frontmatter.timesc}</strong> . Acara ini akan berlangsung di <strong>{frontmatter.locationsc}</strong> yang penuh kehangatan, yaitu di <strong>{frontmatter.addresssc}</strong>. 
                      </small>
                      </div>
                  </div>
            </div>
        </div>
        <div class=`page absolute bg-gray-300 flex flex-col gap-4 p-6`>
                <img src=`${frontmatter.cvrsc}` class="aspect-video object-center object-cover rounded-xl" alt="">
              <div class=``>
                <h4 class=`relative !leading-none text-2xl sm:text-3xl ${frontmatter.txth}`>Temani Kami Menuju <br> <span class=`${frontmatter.font}`>Halal</span></h4>
                <h4 class=`relative font-poppins ${frontmatter.txth} `>{frontmatter.datefs}</h4>
                <Countdown animation={frontmatter.animation} countdown={frontmatter.countdown} bgfs={frontmatter.bgth} txfs={frontmatter.txfs} txsc={frontmatter.txsc} txth={frontmatter.txth} />
              </div>
        </div>
        <div class=`page absolute flex flex-col h-full bg-cover bg-center ${frontmatter.bgfs} ` style={`background-image:url(${frontmatter.pm2})`}>
            <div class="flex flex-col justify-end items-end h-full">
                <div class=`relative p-4 w-full bottom-0 *:relative before:content-[''] before:border before:backdrop-blur-md before:rounded-t-2xl before:inset-0 before:bg-cover before:absolute ${frontmatter.txth} ${frontmatter.before}/20`>
