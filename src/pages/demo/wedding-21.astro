---
import Noheader from '../../layouts/noheader.astro';
import { Icon } from 'astro-icon/components';
import Namatamu from '../../layouts/namatamu.astro'
import Payment from '../../layouts/payment.astro'
import Rsvp from '../../layouts/rsvp.astro'
import Countdown from '../../layouts/countdown.astro'
import Footerpost from '../../layouts/footer-post.astro'
import Audio from '../../layouts/audio.astro'
import Animation from '../../layouts/animation.astro'
import Gallery from "../../layouts/gallery.astro";
import Card from '../../layouts/card.astro';

let {frontmatter} = Astro.props;

if(!frontmatter) {
  let data = {};
  data["title"] = 'wedding-10'
  data["type"] = 'Silver 01'
  data["desc"] = 'wedding-10'
  data["countdown"] = 'Jun 26, 2024 15:37:25'

  data["bgfs"] = 'bg-red-200'
  data["bgsc"] = 'bg-red-900'
  data["bgth"] = 'bg-red-900'

  data["txfs"] = 'text-red-200'
  data["txsc"] = 'text-red-600'
  data["txth"] = 'text-red-900'

  data["bdr"] = 'border-red-900'
  data["from"] = 'from-red-900'
  data["before"] = 'before:bg-black'

  data["cover"] = '/assets/img-5.webp'
  data["imgsc"] = '/assets/img-6.webp'
  data["bg"] = '/assets/dekor-24.webp'

  // dekor
  data["dekorfs"] = '/assets/dekor65.webp'
  data["dekorsc"] = '/assets/dekor17.webp'
  data["dekorth"] = '/assets/dekor24.webp'

  // Img kedua mempelai
  data["pm1"] = '/assets/img-27.webp'
  data["pm2"] = '/assets/img-26.webp'
  
  // Img story
  data["imgstory1"] = '/assets/img-5.webp'
  data["imgstory2"] = '/assets/img-6.webp'
  data["imgstory3"] = '/assets/img-7.webp'
  data["imgstory4"] = '/assets/img-8.webp'
  data["imgstory5"] = '/assets/img-9.webp'
  data["imgstory6"] = '/assets/img-10.webp'
  data["imgstory7"] = '/assets/img-11.webp'
  data["imgstory8"] = '/assets/img-12.webp'
  data["add1"] = '/assets/img-29.webp'
  data["add2"] = '/assets/img-31.webp'

  //img story love
  data["imgstory9"] = '/assets/img-16.webp'
  data["imgstory10"] = '/assets/img-17.webp'
  data["imgstory11"] = '/assets/img-18.webp'

  // data mempelai
  data["male"] = "Remeo"
  data["fullmale"] = "Remeo Alexa"
  data["female"] = "Juliet"
  data["fullfemale"] = "Juliet Kapolo"
  data["music"] = "yovie-nuno-janji-suci"
  data["countdown"] = "June 5, 2025 15:37:25"

  data["childmale"] = "Putra kelima dari Pasangan"
  data["childfemale"] = "Putri Pertama dari Pasangan"
  data["parentmale"] = "Joko & Siti"
  data["parentfemale"] = "Bambang & Mulyani"
  data["instagrammale"] = "instagram"
  data["instagramfemale"] = "instagram"
  data["facebookmale"] = "facebook"
  data["facebookfemale"] = "facebook"
  data["citymale"] = "Palembang"
  data["cityfemale"] = "Makkasar"

  //bank
  data["logoml"] = "/assets/bri.png"
  data["bankml"] = "BRI"
  data["namebankml"] = "Remeo Alexa"
  data["numberbankml"] = "123456789"
  data["logofml"] = "/assets/bca.png"
  data["bankfml"] = "BCA"
  data["namebankfml"] = "Juliet Kapolo"
  data["numberbankfml"] = "123456789"

//waktu & tempat acara
data["datefs"] = "Jumat, 05 Januari 2030"
  data["datesc"] = "Jumat, 05 Januari 2030"
  data["dateth"] = "Jumat, 05 Januari 2030"
  data["timefs"] = "08:00 - 09:00 WIB"
  data["timesc"] = "10:00 - 11:00 WIB"
  data["timeth"] = "13:00 - end WIB"
  data["addressfs"] = "Masjid Kampus UGM"
  data["addresssc"] = "Jogja Expo Center"
  data["addressth"] = "Rumah Mempelai Wanita"
  data["locationfs"] = "Rumah Mempelai Wanita"
  data["locationsc"] = "Rumah Mempelai Wanita"
  data["locationth"] = "Rumah Mempelai Wanita"
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468" 
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468"
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468"
  data["linkmaps"] = "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid"
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi"


  data["quote"] = "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih."

  frontmatter=data;
}

---

<Noheader title={ frontmatter.title } desc={ frontmatter.desc }>
  
  <input type="checkbox" id="toggle" class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear"/>
  <section class=`animasi1 relative h-screen bg-cover bg-center flex items-center overflow-hidden peer-checked:h-0`
    style={`background-image:url(${frontmatter.cover})`}>
    <div class="container mx-auto px-6 relative">
      <div class="flex flex-col justify-evenly items-end gap-8 py-12 relative overflow-hidden h-screen">
        <div class=`flex flex-col items-end gap-2 font-great w-max ${frontmatter.txsc}`>
            <h4 class=`fade-left opacity-0 font-poppins uppercase ${frontmatter.txsc}`>
            The Wedding of
            </h4>
            <div class="flip-right opacity-0 text-5xl text-end">
                <span>{frontmatter.female } <br> & <br>{frontmatter.male }</span>
            </div>
            <h4 class=`fade-down opacity-0 text-md font-poppins uppercase ${frontmatter.txsc}`>
                {frontmatter.datefs }
            </h4>
        </div>
        <img src=`${frontmatter.imgsc}` alt="imgsc" class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
        <div class=`fade-up opacity-0 my-5 w-max text-end ${frontmatter.txsc}`>
            <p>Kepada Yth. <br> Bpk/Ibu/Saudara/i</p>
            <h4 id="invite-name" class="font-bold text-xl capitalize">
                <Namatamu /> nama tamu
            </h4>
        </div>
        <label for="toggle" id="toaudio"
            class=`fade-left opacity-0 px-6 py-2 relative rounded-full mt-2 shadow-xl font-bold flex gap-1 w-max ${frontmatter.txfs} ${frontmatter.bgsc}`>
            Open Invitation <Icon name="mdi:love-letter" class="w-5 h-5" />
        </label>
      </div>
        
    </div>
  </section>
  <main id="myDIV" class=`hidden relative peer-checked:block ${frontmatter.bgth}`>
    <section class=`animasi2 relative bg-cover bg-center overflow-hidden` style={`background-image:url(${frontmatter.cover})`}>
      <div class="container py-20 px-6 mx-auto relative">
      <div class="text-center flex flex-col items-center gap-y-4">
        <div
        class=`fade-right opacity-0 font-great text-center text-4xl md:text-6xl ${frontmatter.txsc}`>
          <span>{ frontmatter.female } & { frontmatter.male }</span>
        </div>
        <div class="flip-right opacity-0 relative flex items-center justify-center">
          <div
          class="w-36 h-64 sm:w-48 sm:h-80 bg-cover bg-center relative rounded-full shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)]"
          style=`background-image: url('${frontmatter.cover}')`>
          </div>
          <img src=`${frontmatter.add1}` alt="JejakBahagia" class="absolute w-36 h-64 sm:w-48 sm:h-80 p-2 bg-cover bg-center rounded-full">
        </div>
        <h4 class=`fade-right opacity-0 text-xl ${frontmatter.txsc}`>{ frontmatter.datefs }</h4>
      </div>
      </div>
    </section>
    <section class=`animasi3 relative bg-cover bg-center overflow-hidden` style={`background-image:url(${frontmatter.cover})`}> 
      <div class="container mx-auto py-12 px-6">
        <div class="w-full mx-auto relative before:content-[''} before:absolute before:h-full before:w-full before:opacity-50 before:bg-gray-200 before:rounded-2xl">
          <div class=`pt-20 pb-6 px-6 flex flex-col text-center items-center relative ${frontmatter.txsc}`>
            <h2 class="fade-down text-center text-2xl font-great">
              Assalamu’alaikum Wr. Wb.
            </h2>
            <p class="fade-left opacity-0 sm:max-w-prose px-5 sm:px-0 max-w-none text-sm">
              Dengan memohon rahmat dan ridho Allah Subhanahu Wa Ta’ala, insyaaAllah kami akan menyelenggarakan acara pernikahan :
            </p>
          </div>
          <div class="mx-auto pb-20 px-6 relative">
            <div class="flex flex-col justify-center items-center gap-11 gap-y-11 max-w-4xl mx-auto *:text-center">
              <div class="flip-down opacity-0 relative flex items-center justify-center max-w-md">
                <img src=`${frontmatter.pm1}` alt="JejakBahagia" class="skew-y-3 aspect-video object-center object-cover rounded-md shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)]">
              </div>
            <div class="w-full flex flex-col items-center">
              <div class=`${frontmatter.txsc}`>
                <p class=`flip-right opacity-0 text-2xl font-bold`>{ frontmatter.fullfemale }</p>
                <p>{frontmatter.childfemale}</p>
                <p class="font-bold">
                  { frontmatter.parentfemale }</p>
                <p>{frontmatter.cityfemale}</p>
                <div class="flex text-center justify-center mt-4">
                  <a href={`https://www.instagram.com/${frontmatter.instagramfemale}`} class="flex flex-row gap-2 items-center">
                    <Icon name="mdi:instagram" class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}` />
                  </a>
                </div>
              </div>
              <div class="inline-flex items-center justify-center w-full">
                <hr class=`w-36 h-px my-8 border-0 ${frontmatter.bgsc}`>
                <span class=`px-3 font-medium text-2xl ${frontmatter.txsc}`>&</span>
                <hr class=`w-36 h-px my-8 border-0 ${frontmatter.bgsc}`>
              </div>
              <div class=`${frontmatter.txsc}`>
                <p class=`flip-right opacity-0 text-2xl font-bold`>{ frontmatter.fullmale }</p>
                <p>{frontmatter.childmale}</p>
                <p class="font-bold">
                  { frontmatter.parentmale }</p>
                <p>{frontmatter.citymale}</p>
                <div class="flex text-center justify-center mt-4">
                  <a href={`https://www.instagram.com/${frontmatter.instagrammale}`} class="flex flex-row gap-2 items-center">
                    <Icon name="mdi:instagram" class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}` />
                  </a>
                </div>
              </div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="animasi4 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <div class="container py-32 mx-auto relative z-10">
        <div class=`text-center my-5 ${frontmatter.txsc}`>
          <h1 class="fade-left opacity-0 text-center font-great text-4xl md:text-6xl">
           our happy day
          </h1>
        </div>
        <img src=`${frontmatter.imgsc}` alt="imgsc" class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
        <div  data-count={frontmatter.countdown} id="timer" class=`fade-up opacity-0  grid grid-cols-2 md:grid-cols-4 gap-y-8 justify-center text-center items-center mt-20 sm:px-20 max-w-3xl mx-auto *:text-center *:text-4xl *:sm:text-6xl *:font-medium *:p-1 ${frontmatter.txsc}`>
        </div>
      </div>
    </section>
    <section class="animasi5 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <div class="container mx-auto py-20 px-6">
        <div class="flip-left opacity-0 relative flex items-center justify-center max-w-md mx-auto">
          <img src=`${frontmatter.pm2}` alt="JejakBahagia" class="aspect-video rounded-md object-top object-cover -skew-y-3 shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)]">
        </div>
        <Card txfs={frontmatter.txfs} txth={frontmatter.txth} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
        <iframe src=`${frontmatter.linkmaps}` style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-3xl h-96 rounded-lg p-1 ${frontmatter.bgth}`></iframe>
      </div>
    </section>
    <section class="animasi6 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <Gallery txsc={frontmatter.txsc} imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="dyna" obj2="top" obj7="top" obj8="top" />
    </section>
    <section class="animasi7 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <div class="container py-20 px-6 text-center mx-auto relative">
          <h2 class=`fade-right opacity-0 text-4xl md:text-6xl text-center my-5 font-great ${frontmatter.txsc}`>
            Do'a & Ucapan
          </h2>
        <Rsvp color="gray-600" />
          
      </div>
    </section>
    <section class="animasi8 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <div class="container py-20 px-6 text-center mx-auto relative z-10">
        <div class=`text-center my-10 ${frontmatter.txsc}`>
          <h2 class="fade-right opacity-0 text-5xl font-great">Wedding Gift</h2>
          <p class="fade-left opacity-0 max-w-prose mx-auto font-bold mt-5">Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan hadiah kepada kedua mempelai dapat mengirimkannya melalui :</p>
        </div>
        <Payment txfs={frontmatter.txfs} txth={frontmatter.txth} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
      </div>
      </div>
    </section>
    <section class="animasi8 relative bg-cover bg-center overflow-hidden" style={`background-image:url(${frontmatter.cover})`}>
      <div class="container p-6 text-center mx-auto relative z-10">
        <div class="min-h-screen py-12 px-6 relative flex flex-col gap-4 justify-center items-center w-full max-w-screen-md mx-auto rounded-2xl before:content-[''} before:absolute before:h-full before:w-full before:opacity-60 before:bg-gray-200 before:rounded-2xl">
          <p class=`fade-left opacity-0 text-center text-sm max-w-prose mx-auto ${frontmatter.txsc}`>{frontmatter.quote}</p>
          <p class="fade-right opacity-0 text-center text-xl font-great">Wassalamu’alaikum Wr. Wb.</p>
          <img src=`${frontmatter.imgsc}` alt="imgsc" class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
          <div class="flip-down opacity-0 relative flex items-center justify-center max-w-md mx-auto">
            <img src=`${frontmatter.add2}` alt="JejakBahagia" class="aspect-video rounded-md object-center object-cover -skew-y-3 shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)]">
          </div>
          <p class="fade-left opacity-0 text-center mt-5">Kami Yang Berbahagia</p>
          <p class="fade-right opacity-0 text-center text-2xl font-great mb-20">{frontmatter.female} & {frontmatter.male}</p>
          <Footerpost />
        </div>
      </div>
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg">
    </audio>
    <Animation /> 
    <Countdown count={frontmatter.countdown} />
  </main>
</Noheader>
