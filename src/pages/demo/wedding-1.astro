---
import Noheader from "../../layouts/noheader.astro";
import { Icon } from "astro-icon/components";
import Namatamu from "../../layouts/namatamu.astro";
import Payment from "../../layouts/payment.astro";
import Rsvp from "../../layouts/rsvp.astro";
import Countdown from "../../layouts/countdown.astro";
import Footerpost from "../../layouts/footer-post.astro";
import Audio from "../../layouts/audio.astro";
import Animation from "../../layouts/animation.astro";
import Gallery from "../../layouts/gallery.astro";
import Card from '../../layouts/card.astro';

let { frontmatter } = Astro.props;

if (!frontmatter) {
  let data = {};
  data["title"] = "wedding-1";
  data["type"] = "Diamond 01";
  data["desc"] = "wedding-1";
  data["countdown"] = "Jun 26, 2024 15:37:25";

  data["bgfs"] = "bg-pink-100";
  data["bgsc"] = "bg-pink-600";
  data["bgth"] = "bg-pink-900";

  data["txfs"] = "text-pink-100";
  data["txsc"] = "text-pink-600";
  data["txth"] = "text-pink-900";

  data["bdr"] = "border-pink-900";
  data["from"] = "from-pink-100";
  data["before"] = "before:bg-black";

  data["cover"] = "/assets/img-12.webp";
  data["imgsc"] = "/assets/img-25.webp";
  data["bg"] = "/assets/dekor-24.webp";
  // Img kedua mempelai
  data["dekorsc"] = "/assets/dekor22.webp";
  data["dekorsc"] = "/assets/dekor23.webp";
  data["dekorth"] = "/assets/dekor24.webp";
  // Img kedua mempelai
  data["pm1"] = "/assets/img-27.webp";
  data["pm2"] = "/assets/img-26.webp";
  // Img kedua mempelai
  data["imgstory1"] = "/assets/img-5.webp";
  data["imgstory2"] = "/assets/img-6.webp";
  data["imgstory3"] = "/assets/img-7.webp";
  data["imgstory4"] = "/assets/img-8.webp";
  data["imgstory5"] = "/assets/img-9.webp";
  data["imgstory6"] = "/assets/img-10.webp";
  data["imgstory7"] = "/assets/img-11.webp";
  data["imgstory8"] = "/assets/img-12.webp";
  data["add1"] = "/assets/img-29.webp";
  data["add2"] = "/assets/img-31.webp";

  //img story love
  data["imgstory9"] = "/assets/img-16.webp";
  data["imgstory10"] = "/assets/img-17.webp";
  data["imgstory11"] = "/assets/img-18.webp";

  // data mempelai
  data["male"] = "Remeo";
  data["fullmale"] = "Remeo Alexa";
  data["female"] = "Juliet";
  data["fullfemale"] = "Juliet Kapolo";
  data["music"] = "Lagu Pernikahan Kita";
  data["countdown"] = "June 5, 2024 15:37:25";

  data["childmale"] = "Putra kelima dari Pasangan";
  data["childfemale"] = "Putri Pertama dari Pasangan";
  data["parentmale"] = "Joko & Siti";
  data["parentfemale"] = "Bambang & Mulyani";
  data["instagrammale"] = "instagram";
  data["instagramfemale"] = "instagram";
  data["facebookmale"] = "facebook";
  data["facebookfemale"] = "facebook";
  data["citymale"] = "Palembang";
  data["cityfemale"] = "Makkasar";

  //bank
  data["logoml"] = "/assets/bri.png";
  data["bankml"] = "BRI";
  data["namebankml"] = "Remeo Alexa";
  data["numberbankml"] = "123456789";
  data["logofml"] = "/assets/bca.png";
  data["bankfml"] = "BCA";
  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["datefs"] = "Jumat, 05 Januari 2030";
  data["datesc"] = "Jumat, 05 Januari 2030";
  data["dateth"] = "Jumat, 05 Januari 2030";
  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
  data["addressfs"] = "Masjid Kampus UGM";
  data["addresssc"] = "Jogja Expo Center";
  data["addressth"] = "Rumah Mempelai Wanita";
  data["locationfs"] = "Rumah Mempelai Wanita";
  data["locationsc"] = "Rumah Mempelai Wanita";
  data["locationth"] = "Rumah Mempelai Wanita";
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["linkmaps"] =
    "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid";
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi"

  //story love
  data["storyfs"] =
    "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe.";
  data["storysc"] =
    "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet.";
  data["storyth"] =
    "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi.";

  data["quote"] =
    "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih.";

  frontmatter = data;
}
---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <input
    type="checkbox"
    id="toggle"
    class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear"
  />
  <section
    class=`animasi1 relative overflow-hidden peer-checked:h-0 peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear peer-checked:delay-500 ${frontmatter.bgfs}`
  >
    <div class="mx-auto relative h-screen flex flex-col md:flex-row *:w-full">
      <div
        class=`relative h-96 md:h-screen bg-cover bg-center before:content-[''] before:md:bg-gradient-to-t before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
        style={`background-image:url(${frontmatter.cover})`}
      >
      </div>
      <div class="relative pb-12 flex flex-col items-center justify-center order-last">
        <div
          class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:w-1/3 *:lg:w-1/5"
        >
          <div>
            <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
          </div>
          <div class="right-0 top-0 hidden md:block">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 right-0 top-0"
              alt="JejakBahagia"
            />
          </div>
          <div class="left-0 bottom-0 hidden md:block">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 -scale-100"
              alt="JejakBahagia"
            />
          </div>
          <div class="bottom-0 right-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-180"
              alt="JejakBahagia"
            />
          </div>
        </div>
        <div
          class=`flip-left opacity-0 font-cinzel text-center text-4xl md:text-6xl *:leading-7 ${frontmatter.txsc}`
        >
          <span>{frontmatter.female}</span> <br>
          <span> & </span><br>
          <span> {frontmatter.male} </span>
        </div>
        <div class=`text-center ${frontmatter.txth}`>
          <p class="fade-right opacity-0 text-sm mt-2">Kpd Bpk/Ibu/Saudara/i</p>
          <h4
            id="invite-name"
            class="fade-right opacity-0 text-xl font-bold capitalize"
          >
            <Namatamu /> Nama Tamu
          </h4>
          <p class="fade-right opacity-0 mt-2">di Tempat</p>
        </div>
        <label
          for="toggle"
          id="toaudio"
          class=`fade-left opacity-0 mt-5 px-6 py-2 w-max relative rounded-full shadow-xl font-bold flex gap-1 ${frontmatter.txfs} ${frontmatter.bgsc}`
          >Open Invitation <Icon
            name="mdi:love-letter"
            class="w-5 h-5"
          /></label
        >
      </div>
    </div>
  </section>
  <main id="myDIV" class="hidden bg-pink-100 peer-checked:block">
    <section
      class=`animasi2 relative overflow-hidden`
     >
      <div class="container mx-auto relative h-screen flex flex-col md:flex-row *:w-full">
        <div
          class=`relative h-96 md:h-screen bg-cover bg-center before:content-[''] before:md:bg-gradient-to-t before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
          style={`background-image:url(${frontmatter.imgsc})`}
        >
        </div>
        <div class="relative px-6 flex flex-col items-center justify-center md:order-first">
          <div
            class="mx-auto flex flex-col justify-between items-center relative z-10 font-cinzel"
          >
            <h2
              class=`fade-down opacity-0 font-poppins text-xl mt-4 ${frontmatter.txth}`
            >
              The Wedding of
            </h2>
            <div
              class=`flip-left opacity-0 font-cinzel text-center text-4xl sm:text-6xl *:leading-7 ${frontmatter.txsc}`
            >
              <span>{frontmatter.female}</span> <br>
              <span> & </span><br>
              <span> {frontmatter.male} </span>
            </div>
            <h3
              class=`fade-right opacity-0 font-poppins text-xl ${frontmatter.txsc}`
            >
              {frontmatter.datefs}
            </h3>
          </div>
        </div>
      </div>
    </section>
    <section class="animasi4 relative overflow-hidden">
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] *:absolute *:object-cover *:w-1/3 *:lg:w-1/5"
      >
        <div>
          <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
        </div>
        <div class="right-0 top-0">
          <img
            src=`${frontmatter.dekorsc}`
            class="rotate-90 right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="left-0 bottom-0">
          <img
            src=`${frontmatter.dekorsc}`
            class="rotate-90 -scale-100"
            alt="JejakBahagia"
          />
        </div>
        <div class="bottom-0 right-0">
          <img
            src=`${frontmatter.dekorsc}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-12 px-6 mx-auto">
        <div
          class=`flex flex-col text-center items-center mb-9 ${frontmatter.txsc}`
        >
          <h1
            class="fade-left opacity-0 text-center font-cinzel text-3xl md:text-5xl"
          >
            Bride x Groom
          </h1>
          <p class="fade-up opacity-0 font-medium pb-8 text-sm max-w-md mx-auto">
            Dengan memohon rahmat dan ridho Allah Subhanahu Wa Ta’ala, insyaaAllah kami akan menyelenggarakan acara pernikahan 
          </p>
        </div>
        <div class="mx-auto p-4">
          <div
            class="flex flex-col sm:flex-row justify-center items-center gap-11 gap-y-11 max-w-4xl mx-auto *:text-center"
          >
          <div class="w-full flex flex-col items-center">
            <div
              class="flip-left opacity-0 relative w-72"
            >
            <img
              src=`${frontmatter.pm1}`
              alt="JejakBahagia"
              class="aspect-square rounded-md shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] border-4"
            />
            </div>
            <div class="font-poppins space-y-3 text-left">
              <h3
                class=`flip-left opacity-0 text-3xl mt-6 font-cinzel ${frontmatter.txsc}`
              >
                {frontmatter.fullfemale}
              </h3>
              <div class="fade-up opacity-0 ">
                <p>{frontmatter.childfemale}</p>
                <p class=`${frontmatter.txth}`>
                  {frontmatter.parentfemale}
                </p>
                <p>{frontmatter.cityfemale}</p>
                <div class="mt-4">
                  <a
                    href={`https://www.instagram.com/${frontmatter.instagramfemale}`}
                    class="flex flex-row gap-2 items-center"
                  >
                    <Icon
                      name="mdi:instagram"
                      class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}`
                    />
                  </a>
                </div>
              </div>
            </div>
          </div>
            <div class="w-full flex flex-col items-center">
              <div
                class="flip-right opacity-0 relative w-72"
              >
              <img
                src=`${frontmatter.pm2}`
                alt="JejakBahagia"
                class="aspect-square rounded-md shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] border-4"
              />
              </div>
              <div class="font-poppins space-y-3 text-left">
                <h3
                  class=`flip-left opacity-0 text-3xl mt-6 font-cinzel ${frontmatter.txsc}`
                >
                  {frontmatter.fullmale}
                </h3>
                <div class="fade-up opacity-0 ">
                  <p>{frontmatter.childmale}</p>
                  <p class=`${frontmatter.txth}`>
                    {frontmatter.parentmale}
                  </p>
                  <p>{frontmatter.citymale}</p>
                  <div class="mt-4">
                    <a
                      href={`https://www.instagram.com/${frontmatter.instagrammale}`}
                      class="flex flex-row gap-2 items-center"
                    >
                      <Icon
                        name="mdi:instagram"
                        class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}`
                      />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <section
        class=`animasi5 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}`
        style={`background-image:url(${frontmatter.add1})`}
      >
        <div class="container py-32 mx-auto relative z-10">
          <div class="text-center my-5">
            <h1
              class=`fade-right opacity-0 text-center font-cinzel text-3xl md:text-5xl ${frontmatter.txsc}`
            >
              Our Happy Day
            </h1>
          </div>
          <div
            data-count={frontmatter.countdown}
            id="timer"
            class=`fade-up opacity-0 grid grid-cols-2 md:grid-cols-4 gap-y-8 justify-center text-center items-center mt-20 sm:px-20 max-w-3xl mx-auto *:text-center *:text-4xl *:sm:text-6xl *:font-bold *:p-1 ${frontmatter.txth}`
          >
          </div>
          <div
            id="endevent"
            class="fade-up opacity-0 hidden leading-8 text-white text-2xl capitalize font-cinzel"
          >
            Event Telah Berakhir
          </div>
        </div>
      </section>
      <section class="animasi6 overflow-hidden relative">
        <div
          class="absolute overflow-hidden z-20 w-full h-[100%] *:absolute *:object-cover *:w-1/3 *:lg:w-1/5"
        >
          <div>
            <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
          </div>
          <div class="right-0 top-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 right-0 top-0"
              alt="JejakBahagia"
            />
          </div>
          <div class="left-0 bottom-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 -scale-100"
              alt="JejakBahagia"
            />
          </div>
          <div class="bottom-0 right-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-180"
              alt="JejakBahagia"
            />
          </div>
        </div>
        <div class="container mx-auto py-20 px-6 relative z-50">
          <div class=`text-center my-5 mb-10 ${frontmatter.txsc}`>
            <h1
              class="fade-left opacity-0 text-center font-cinzel text-3xl md:text-5xl"
            >
              Wedding Day
            </h1>
          </div>
          <Card txfs={frontmatter.txfs} txth={frontmatter.txth} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
          <iframe
            src=`${frontmatter.linkmaps}`
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-3xl h-96 rounded-lg p-1 ${frontmatter.bgth}`
          ></iframe>
        </div>
      </section>
      <section class="animasi8 overflow-hidden relative">
        <Gallery txsc={frontmatter.txsc} imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="cinzel" />
      </section>
      <section
        class="animasi9 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden"
      >
        <div
          class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/2 [&>*]:lg:w-1/5"
        >
          <div>
            <img src=`${frontmatter.dekorsc}` class="" alt="JejakBahagia" />
          </div>
          <div class="right-0 top-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 right-0 top-0"
              alt="JejakBahagia"
            />
          </div>
          <div class="left-0 bottom-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-90 -scale-100"
              alt="JejakBahagia"
            />
          </div>
          <div class="bottom-0 right-0">
            <img
              src=`${frontmatter.dekorsc}`
              class="rotate-180"
              alt="JejakBahagia"
            />
          </div>
        </div>
        <div class="container py-20 px-6 text-center mx-auto relative z-50">
          <div class=`text-center my-10 ${frontmatter.txsc}`>
            <h2 class="fade-right opacity-0 text-3xl md:text-5xl font-cinzel">
              Wedding Gift
            </h2>
            <p
              class="fade-left opacity-0 max-w-prose mx-auto mt-5 text-xs"
            >
            Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan hadiah kepada kedua mempelai dapat mengirimkannya melalui :
            </p>
          </div>
          <Payment txfs={frontmatter.txfs} txth={frontmatter.txth} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
        </div>
      </section>
    </section>
    <section class="animasi10 overflow-hidden relative">
      <div
        class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/2 [&>*]:lg:w-1/5"
      >
        <div class="left-0 bottom-0">
          <img
            src=`${frontmatter.dekorsc}`
            class="rotate-90 -scale-100"
            alt="JejakBahagia"
          />
        </div>
        <div class="bottom-0 right-0">
          <img
            src=`${frontmatter.dekorsc}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 z-50 px-6 text-center mx-auto relative">
        <div class:list={[`text-center my-5 mb-10 ${frontmatter.txsc}`]}>
          <h2 class="fade-right opacity-0 text-3xl md:text-5xl font-cinzel">
             Doa & Ucapan 
          </h2>
        </div>

        <Rsvp color="gray-600" />
      </div>
      <Footerpost />
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg" />
    </audio>
    <Animation />
    <Countdown count={frontmatter.countdown} />
  </main>
</Noheader>
