  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["countdown"] = "June 5, 2024 15:37:25";  
  data["dateakd"] = "05 Oktober 2028"
  data["datersp"] = "10 Oktober 2028"
  data["dayfs"] = "Jum'at";
  data["daysc"] = "Sabtu";
  data["dayth"] = "Minggu";
  data["datefs"] = "05"
  data["datesc"] = "07"
  data["dateth"] = "05"
  data["monthfs"] = "Januari";
  data["monthsc"] = "Februari";
  data["monthth"] = "Maret";
  data["yearfs"] = "2030";
  data["yearsc"] = "2030";

  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
