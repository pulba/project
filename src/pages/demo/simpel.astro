---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <input type="checkbox" id="toggle" class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear"/>
  <section class=`relative overflow-hidden transition-[max-height,transform] duration-700 ease-linear max-h-[1000px] transform translate-y-0 peer-checked:max-h-0 peer-checked:translate-y-[-200px] peer-checked:overflow-hidden bg-cover bg-center before:content-[''] before:absolute before:opacity-70 before:inset-0 ${frontmatter.before}` style={`background-image:url(${frontmatter.cover})`}>
      <div class=`container py-12 relative h-screen flex flex-col items-center justify-between z-50`>
        <div class=`relative z-50 text-center ${frontmatter.txfs}`>
          <h5 class="flip-down opacity-0 italic font-niconne text-2xl">The Wedding of</h5>
        <h2 class=`fade-left opacity-0 leading-7 ${frontmatter.font} `>{frontmatter.female} & {frontmatter.male}</h2>
        <h5 class="fade-right opacity-0 italic mt-5">{frontmatter.dateakd}</h5>
        </div>
        <div class=`relative text-center my-5 ${frontmatter.txfs}`>
          <p class="fade-right opacity-0 text-sm mt-2">Kepada YTH:</p>
          <h4 id="invite-name" class="fade-right opacity-0 text-xl font-bold capitalize">
