      </div>
    </section>
    <section class=`overflow-hidden ${frontmatter.display} relative bg-cover bg-center bg-fixed before:content-[''] before:absolute before:opacity-70 before:inset-0 ${frontmatter.before}` style={`background-image:url(${frontmatter.cvrfv})`}>
