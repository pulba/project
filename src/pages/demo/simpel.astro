      </div>
    </section>
    <section class=`${frontmatter.bgth} ${frontmatter.txfs} relative overflow-hidden bg-cover bg-center before:content-[''] before:absolute before:opacity-70 before:inset-0 ${frontmatter.before}` style={`background-image:url(${frontmatter.cvrth})`}>
