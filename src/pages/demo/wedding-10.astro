---
import Noheader from '../../layouts/noheader.astro';
import { Icon } from 'astro-icon/components';
import Namatamu from '../../layouts/namatamu.astro'
import Payment from '../../layouts/payment.astro'
import Rsvp from '../../layouts/rsvp.astro'
import Countdown from '../../layouts/countdown.astro'
import Footerpost from '../../layouts/footer-post.astro'
import Audio from '../../layouts/audio.astro'
import Animation from '../../layouts/animation.astro';
import Gallery from "../../layouts/gallery.astro";
import Card from '../../layouts/card.astro';

let {frontmatter, count} = Astro.props;

if(!frontmatter) {
  let data = {};
  data["title"] = 'wedding-8'
  data["type"] = 'wedding-8'
  data["desc"] = 'wedding-8'
  data["countdown"] = 'Jun 26, 2024 15:37:25'

  data["bgfs"] = 'bg-white'
  data["bgsc"] = 'bg-yellow-100'
  data["bgth"] = 'bg-sky-800'

  data["txfs"] = 'text-white'
  data["txsc"] = 'text-yellow-100'
  data["txth"] = 'text-gray-800'

  data["bdr"] = 'border-sky-100'
  data["from"] = 'from-sky-800'
  data["before"] = 'before:bg-sky-800'

  data["cover"] = '/assets/img-6.webp'
  data["imgsc"] = '/assets/img-20.webp'
  data["bg"] = '/assets/dekor-24.webp'

  // dekor
  data["dekorfs"] = '/assets/dekor31.webp'
  data["dekorsc"] = '/assets/dekor10.webp'
  data["dekorth"] = '/assets/dekor28.webp'
  data["dekorfr"] = '/assets/dekor29.webp'
  data["dekorfv"] = '/assets/dekor26.webp'

  // Img kedua mempelai
  data["pm1"] = '/assets/img-27.webp'
  data["pm2"] = '/assets/img-26.webp'

  // Img story mempelai
  data["imgstory1"] = '/assets/img-5.webp'
  data["imgstory2"] = '/assets/img-6.webp'
  data["imgstory3"] = '/assets/img-7.webp'
  data["imgstory4"] = '/assets/img-8.webp'
  data["imgstory5"] = '/assets/img-9.webp'
  data["imgstory6"] = '/assets/img-10.webp'
  data["imgstory7"] = '/assets/img-11.webp'
  data["imgstory8"] = '/assets/img-12.webp'
  data["add1"] = '/assets/img-29.webp'
  data["add2"] = '/assets/img-31.webp'
  data["hdd"] = 'display: none;'

  //img story love
  data["imgstory9"] = '/assets/img-16.webp'
  data["imgstory10"] = '/assets/img-17.webp'
  data["imgstory11"] = '/assets/img-18.webp'

  // data mempelai
  data["male"] = "Remeo"
  data["fullmale"] = "Remeo Alexa"
  data["female"] = "Juliet"
  data["fullfemale"] = "Juliet Kapolo"
  data["music"] = "yovie-nuno-janji-suci"
  data["countdown"] = "June 5, 2025 15:37:25"

  data["childmale"] = "Putra kelima dari Pasangan"
  data["childfemale"] = "Putri Pertama dari Pasangan"
  data["parentmale"] = "Joko & Siti"
  data["parentfemale"] = "Bambang & Mulyani"
  data["instagrammale"] = "instagram"
  data["instagramfemale"] = "instagram"
  data["facebookmale"] = "facebook"
  data["facebookfemale"] = "facebook"
  data["citymale"] = "Palembang"
  data["cityfemale"] = "Makkasar"

  //bank
  data["logoml"] = "/assets/bri.png"
  data["bankml"] = "BRI"
  data["namebankml"] = "Remeo Alexa"
  data["numberbankml"] = "123456789"
  data["logofml"] = "/assets/bca.png"
  data["bankfml"] = "BCA"
  data["namebankfml"] = "Juliet Kapolo"
  data["numberbankfml"] = "123456789"

//waktu & tempat acara
data["datefs"] = "Jumat, 05 Januari 2030"
  data["datesc"] = "Jumat, 05 Januari 2030"
  data["dateth"] = "Jumat, 05 Januari 2030"
  data["timefs"] = "08:00 - 09:00 WIB"
  data["timesc"] = "10:00 - 11:00 WIB"
  data["timeth"] = "13:00 - end WIB"
  data["addressfs"] = "Masjid Kampus UGM"
  data["addresssc"] = "Jogja Expo Center"
  data["addressth"] = "Rumah Mempelai Wanita"
  data["locationfs"] = "Rumah Mempelai Wanita"
  data["locationsc"] = "Rumah Mempelai Wanita"
  data["locationth"] = "Rumah Mempelai Wanita"
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468" 
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468"
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468"
  data["linkmaps"] = "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid"

//story love
  data["storyfs"] = "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe."
  data["storysc"] = "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet."
  data["storyth"] = "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi."

  data["quote"] = "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih."

  frontmatter=data;
}
---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>

  <input type="checkbox" id="toggle" class="peer hidden peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear " />
  <section class=`animasi1 relative h-screen bg-cover bg-center overflow-hidden peer-checked:h-0 peer-checked:transition-all peer-checked:duration-700 peer-checked:ease-linear peer-checked:delay-500` style={`background-image:url(${frontmatter.bg})`}>
    <div
      class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
      <div class="fade-right opacity-0 -right-5 -top-5">
        <img
          src=`${frontmatter.dekorfs}`
          class="right-0 top-0"
          alt="JejakBahagia"
        />
      </div>
      <div class="fade-left opacity-0 -bottom-5 -left-5">
        <img
          src=`${frontmatter.dekorfs}`
          class="rotate-180"
          alt="JejakBahagia"
        />
      </div>
    </div>
    <div class=`container h-screen py-20 mx-auto flex flex-col justify-between items-center relative z-50 ${frontmatter.txfs}`>
      <h4 class="fade-left opacity-0 text-sm md:text-xl mt-8 tracking-widest font-semibold">
          WEDDING INVITATION
      </h4>
      <div class="fade-down opacity-0 flex flex-col sm:flex-row gap-2 text-center font-dyna font-thin text-center text-6xl lg:text-7xl">
        <span>{frontmatter.female }</span>
        <span> & </span> 
        <span> {frontmatter.male } </span> 
      </div>
      <div class="text-center">
        <div class="fade-right opacity-0 bg-white/50 rounded-lg border-2 py-2 px-6 text-gray-800">
          <p class="mt-2">Kpd Bpk/Ibu/Saudara/i</p>
          <h4 id="invite-name" class="font-bold text-xl my-2 capitalize">
            <Namatamu /> nama tamu
          </h4>
        </div>
          
          <label
            for="toggle" id="toaudio"
            class=`fade-left opacity-0 w-fit mx-auto mt-5 px-6 py-2 relative rounded-full font-bold flex gap-1 ${frontmatter.txth} ${frontmatter.bgfs}`>Open Invitation </label>
      </div>
    </div>
  </section>
  <main id="myDIV" class="hidden peer-checked:block scroll-smooth">
    <section class=`animasi2 relative bg-cover bg-center overflow-hidden` style={`background-image:url(${frontmatter.bg})`}>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
        <div class="fade-right opacity-0 -right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="fade-left opacity-0 -bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class=`container h-screen pb-20 mx-auto flex flex-col justify-center items-center relative z-50 ${frontmatter.txfs}`>        
          <div class="text-center max-w-md mx-auto">
              <h1 class="fade-down opacity-0 text-sm my-8 tracking-widest font-semibold">THE WEDDING OFF
              </h1>
              <div
              class="fade-down opacity-0 flex flex-col sm:flex-row gap-2 text-center font-dyna font-thin text-center text-6xl lg:text-7xl">
              <span>{frontmatter.female }</span>
              <span> & </span> 
              <span> {frontmatter.male } </span> 
            </div>
            <p class="italic fade-right opacity-0">{frontmatter.quote}</p>
          </div>
          </div>
        </div>
    </section>
    <section class=`animasi3 relative bg-cover bg-center overflow-hidden` style={`background-image:url(${frontmatter.cover})`}>
      </div>
        <div class="container px-6 py-20 mx-auto relative">
          <div class=`${frontmatter.txsc}`>
            <div class="text-center w-full max-w-screen-md mx-auto">
              <div  data-count={frontmatter.countdown} id="timer" class=`fade-up opacity-0 grid grid-cols-2 md:grid-cols-4 gap-8 justify-center text-center items-center mt-20 sm:px-20 max-w-screen-lg mx-auto *:text-center *:text-4xl *:sm:text-6xl *:font-bold *:p-1 ${frontmatter.txsc}`>
            </div>
          </div>
        </div>
    </section>
    <section class=`animasi3 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden`
    style={`background-image:url(${frontmatter.cover})`}>
    <div
      class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
      <div class="fade-right opacity-0 -right-5 -top-5">
        <img
          src=`${frontmatter.dekorfs}`
          class="right-0 top-0"
          alt="JejakBahagia"
        />
      </div>
      <div class="fade-left opacity-0 -bottom-5 -left-5">
        <img
          src=`${frontmatter.dekorfs}`
          class="rotate-180"
          alt="JejakBahagia"
        />
      </div>
    </div>
      <div class="container mx-auto px-6 py-20 relative">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-4xl mx-auto mt-12">
          <div class="relative items-center justify-center mx-auto w-full">
            <div class="text-center overflow-hidden flex items-center justify-center md:items-end md:justify-end">
              <div class="fade-right relative flex items-center justify-center w-72">
                <div class=`w-64 h-64 bg-cover bg-center relative rounded-full border-4 shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${frontmatter.bdr}`
                style={`background-image:url('${frontmatter.pm1}')`}>
                </div>
              </div>
            </div>
          </div>
          <div class="relative text-center sm:text-left mx-auto w-full">
            <h3 class=`fade-down opacity-0 text-5xl mt-6 font-dyna ${frontmatter.txfs}`>{ frontmatter.fullfemale }</h3>
            <div class=`fade-up opacity-0 space-y-3 ${frontmatter.txfs}`>
              <p class="text-lg">{frontmatter.childfemale}</p>
              <p class=`text-lg font-bold`>
                { frontmatter.parentfemale }</p>
              <p>{frontmatter.cityfemale}</p>
              <a href={`https://www.instagram.com/${frontmatter.instagramfemale}`} class="flex flex-row gap-2 items-center justify-center sm:justify-start">
                <Icon name="mdi:instagram" class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgth}` />
              </a>
            </div>
          </div>
          <div class="relative items-center justify-center mx-auto w-full sm:order-last">
            <div class="text-center overflow-hidden flex items-center justify-center md:items-start md:justify-start">
              <div class="fade-right relative flex items-center justify-center w-72">
                <div class=`w-64 h-64 bg-cover bg-center relative rounded-full border-4 shadow-[4.0px_8.0px_8.0px_rgba(0,0,0,0.38)] ${frontmatter.bdr}`
                style={`background-image:url('${frontmatter.pm2}')`}>
                </div>
              </div>
            </div>
            </div>
            <div class="relative text-center sm:text-right mx-auto w-full">
              <h3 class=`fade-down opacity-0 text-5xl mt-6 font-dyna ${frontmatter.txfs}`>{ frontmatter.fullfemale }</h3>
              <div class=`fade-up opacity-0 space-y-3 ${frontmatter.txfs}`>
                <p class="text-lg">{frontmatter.childfemale}</p>
                <p class="text-lg font-bold">
                  { frontmatter.parentmale }</p>
                <p>{frontmatter.citymale}</p>
                <a href={`https://www.instagram.com/${frontmatter.instagrammale}`} class="flex flex-row gap-2 items-center justify-center sm:justify-end">
                  <Icon name="mdi:instagram" class=`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgth}` />
                </a>
              </div>
            </div>
        </div>
      </div>
    </section>
    <section class=`animasi4 relative bg-cover bg-center overflow-hidden` style={`background-image:url(${frontmatter.cover})`}>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
        <div class="fade-right opacity-0 -right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="fade-left opacity-0 -bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container mx-auto py-20 px-6">
        <div class=`text-center my-5 mb-10 ${frontmatter.txfs}`>
          <h1 class="fade-left opacity-0 text-center font-dyna text-5xl lg:text-8xl">
            Tempat & Waktu
          </h1>
        </div>
        <Card txfs={frontmatter.txfs} txth={frontmatter.txfs} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
        <iframe src=`${frontmatter.linkmaps}` style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-3xl h-96 rounded-lg p-1 ${frontmatter.bgth}`></iframe>
      </div>
    </section>
    <section class=`animasi5 relative bg-cover bg-center overflow-hidden before:content-[''] before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}` style={`background-image:url(${frontmatter.cover})`}>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
        <div class="fade-right opacity-0 -right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="fade-left opacity-0 -bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <Gallery txsc={frontmatter.txsc} imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="dyna" />
    </section>
    <section
      class="animasi7 relative bg-cover bg-center overflow-hidden"
      style={`background-image:url(${frontmatter.cover})`}>
      <div class="absolute overflow-hidden z-20 w-full h-[100%] [&>*]:absolute [&>*]:object-cover [&>*]:w-1/3 [&>*]:md:w-1/5"
      >
        <div class="fade-down opacity-0">
          <img src=`${frontmatter.dekorfs}` class="" alt="JejakBahagia" />
        </div>
        <div class="fade-up opacity-0 right-0 top-0">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 px-6 text-center mx-auto relative z-50">
        <div class:list={[`${frontmatter.txfs}`]}>
          <h2 class="fade-right opacity-0 text-5xl md:text-6xl font-alex">
            Wedding Gift
          </h2>
          <p
            class="fade-left opacity-0 max-w-md mx-auto mt-5 font-kaushan"
          >
          Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan hadiah kepada kedua mempelai dapat mengirimkannya melalui :
          </p>
        </div>
        <Payment txfs={frontmatter.txfs} txth={frontmatter.txfs} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
      </div>
    </section>
    <section class=`animasi6 relative bg-cover bg-center overflow-hidden before:content-[''] before:bg-gradient-to-t before:to-transparent before:inset-0 before:bg-cover before:absolute ${frontmatter.from}` style={`background-image:url(${frontmatter.cover})`}>
      <div
        class="absolute overflow-hidden w-full h-[100%] *:absolute *:object-cover *:max-w-xs *:lg:max-w-sm">
        <div class="fade-right opacity-0 -right-5 -top-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="right-0 top-0"
            alt="JejakBahagia"
          />
        </div>
        <div class="fade-left opacity-0 -bottom-5 -left-5">
          <img
            src=`${frontmatter.dekorfs}`
            class="rotate-180"
            alt="JejakBahagia"
          />
        </div>
      </div>
      <div class="container py-20 z-50 px-6 text-center mx-auto relative">
        <div class:list={[`text-center my-5 mb-10 ${frontmatter.txsc}`]}>
          <h2 class="fade-right opacity-0 text-6xl lg:text-8xl font-dyna">
            Doa & Ucapan 
          </h2>
        </div>

        <Rsvp color="gray-600" />
          
      </div>
      <Footerpost />
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg">
    </audio>
    <Animation /> 
    <Countdown count={frontmatter.countdown} />
  </main>
</Noheader>

