---
import Noheader from "../../layouts/noheader.astro";
import Icon from "../../components/icon.astro";
import Namatamu from "../../layouts/namatamu.astro";
import Payment from "../../layouts/payment.astro";
import Rsvp from "../../layouts/rsvp.astro";
import Countdown from "../../layouts/countdown.astro";
import Footerpost from "../../layouts/footer-post.astro";
import Audio from "../../layouts/audio.astro";
import Animation from "../../layouts/animation.astro";
import Gallery from "../../layouts/gallery.astro";
import Card from '../../layouts/card.astro';

let { frontmatter } = Astro.props;

if (!frontmatter) {
  let data = {};
  data["title"] = "wedding-4";
  data["type"] = "Diamond 03";
  data["desc"] = "wedding-4";
  data["countdown"] = "Jun 26, 2024 15:37:25";

  data["bgfs"] = "bg-blue-100";
  data["bgsc"] = "bg-blue-600";
  data["bgth"] = "bg-blue-900";

  data["txfs"] = "text-blue-200";
  data["txsc"] = "text-blue-600";
  data["txth"] = "text-blue-900";

  data["bdr"] = "border-blue-600";
  data["from"] = "from-blue-100";
  data["before"] = "before:bg-black";

  data["cover"] = "/assets/dekor27.webp";
  data["imgsc"] = "/assets/img-20.webp";
  data["bg"] = "/assets/dekor-24.webp";

  // Img dekor
  data["dekorfs"] = "/assets/dekor1.webp";
  data["dekorsc"] = "/assets/dekor2.webp";
  data["dekorth"] = "/assets/dekor28.webp";
  data["dekorfe"] = "/assets/dekor29.webp";
  data["dekorfv"] = "/assets/dekor26.webp";

  // Img kedua mempelai
  data["pm1"] = "/assets/img-27.webp";
  data["pm2"] = "/assets/img-26.webp";

  // Img story mempelai
  data["imgstory1"] = "/assets/img-5.webp";
  data["imgstory2"] = "/assets/img-6.webp";
  data["imgstory3"] = "/assets/img-7.webp";
  data["imgstory4"] = "/assets/img-8.webp";
  data["imgstory5"] = "/assets/img-9.webp";
  data["imgstory6"] = "/assets/img-10.webp";
  data["imgstory7"] = "/assets/img-11.webp";
  data["imgstory8"] = "/assets/img-12.webp";
  data["add1"] = "/assets/dekor27.webp";
  data["add2"] = "/assets/img-4.webp";

  //img story love
  data["imgstory9"] = "/assets/img-16.webp";
  data["imgstory10"] = "/assets/img-17.webp";
  data["imgstory11"] = "/assets/img-18.webp";

  // data mempelai
  data["male"] = "Remeo";
  data["fullmale"] = "Remeo Alexa";
  data["female"] = "Juliet";
  data["fullfemale"] = "Juliet Kapolo";
  data["music"] = "yovie-nuno-janji-suci";
  data["countdown"] = "June 5, 2025 15:37:25";

  data["childmale"] = "Putra kelima dari Pasangan";
  data["childfemale"] = "Putri Pertama dari Pasangan";
  data["parentmale"] = "Joko & Siti";
  data["parentfemale"] = "Bambang & Mulyani";
  data["instagrammale"] = "instagram";
  data["instagramfemale"] = "instagram";
  data["facebookmale"] = "facebook";
  data["facebookfemale"] = "facebook";
  data["citymale"] = "Palembang";
  data["cityfemale"] = "Makkasar";

  //bank
  data["logoml"] = "/assets/bri.png";
  data["bankml"] = "BRI";
  data["namebankml"] = "Remeo Alexa";
  data["numberbankml"] = "123456789";
  data["logofml"] = "/assets/bca.png";
  data["bankfml"] = "BCA";
  data["namebankfml"] = "Juliet Kapolo";
  data["numberbankfml"] = "123456789";

  //waktu & tempat acara
  data["datefs"] = "Jumat, 05 Januari 2030";
  data["datesc"] = "Jumat, 05 Januari 2030";
  data["dateth"] = "Jumat, 05 Januari 2030";
  data["timefs"] = "08:00 - 09:00 WIB";
  data["timesc"] = "10:00 - 11:00 WIB";
  data["timeth"] = "13:00 - end WIB";
  data["addressfs"] = "Masjid Kampus UGM";
  data["addresssc"] = "Jogja Expo Center";
  data["addressth"] = "Rumah Mempelai Wanita";
  data["locationfs"] = "Rumah Mempelai Wanita";
  data["locationsc"] = "Rumah Mempelai Wanita";
  data["locationth"] = "Rumah Mempelai Wanita";
  data["mapsfs"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapssc"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["mapsth"] = "https://maps.app.goo.gl/fpXEChVvcrKveA468";
  data["linkmaps"] =
    "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3953.144855136041!2d110.3807054!3d-7.7744606!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a59b4fe07a7f9%3A0x2f7c4fd3d72616bb!2sJl.%20Prof.%20DR.%20Drs%20Notonagoro%2C%20Karang%20Malang%2C%20Caturtunggal%2C%20Kec.%20Depok%2C%20Kabupaten%20Sleman%2C%20Daerah%20Istimewa%20Yogyakarta%2055281!5e0!3m2!1sid!2sid!4v1717643524613!5m2!1sid!2sid";
  data["akad"] = "Akad"
  data["resepsi"] = "Resepsi"

  //story love
  data["storyfs"] =
    "Di sebuah kafe yang nyaman di tengah kota, dua orang asing, Yanti dan Yanto, tak sengaja bertemu. Yanto, seorang fotografer yang sedang mencari inspirasi untuk proyek terbarunya, sedangkan Yanti, seorang penulis lepas yang sedang mencatat ide-ide baru untuk novel romantisnya, tak menyadari bahwa matanya sedang bertatapan dengan seorang pria tampan di sisi lain kafe.";
  data["storysc"] =
    "Beberapa bulan kemudian, Romeo memutuskan bahwa dia tidak ingin kehilangan Juliet dari hidupnya. Dengan hati yang penuh harap, dia menyiapkan proposal yang tak terlupakan. Di bawah langit malam yang cerah, di taman yang dihiasi dengan ratusan lentera, Romeo berlutut di hadapan Juliet.";
  data["storyth"] =
    "Dari pertemuan tak terduga di kafe hingga momen indah pertunangan mereka di taman yang dipenuhi lentera, cerita cinta Juliet dan Romeo adalah bukti bahwa takdir bisa membawa dua hati yang saling mencari dan membuat mereka bersatu dalam cinta yang abadi.";

  data["quote"] =
    "Dengan segala kerendahan hati, kami sangat berbahagia bisa membagi saat-saat penting ini kepada Bapak/Ibu/Saudara/i. Besar harapan kami atas kehadiran serta iringan doa dan restunya agar pernikahan yang akan digelar bisa berjalan sebagaimana mestinya. Terimakasih.";

  frontmatter = data;
}
---

<Noheader title={frontmatter.title} desc={frontmatter.desc}>
  <input type="checkbox" id="toggle" class="peer hidden" />
  <section
    class=`peer-checked:h-0 peer-checked:transition peer-checked:ease-in-out peer-checked:delay-150 bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden before:content-[''] before:inset-0 before:bg-cover before:absolute before:opacity-70 ${frontmatter.before}`
    style={`background-image:url(${frontmatter.cover})`}
  >
    <div class="container mx-auto px-6">
      <div
        class="flex flex-col justify-evenly items-center relative overflow-hidden h-screen"
      >
        <h4
          class=`fade-right opacity-0 text-sm font-poppins uppercase ${frontmatter.txfs}`
        >
          The Wedding of
        </h4>
        <div
          class=`flip-right opacity-0 flex flex-row gap-2 pl-5 font-montecarlo text-6xl lg:text-8xl ${frontmatter.txfs}`
        >
          <span>{frontmatter.female}</span>
          <span> & </span>
          <span> {frontmatter.male} </span>
        </div>
        <div class=`fade-right opacity-0 text-center ${frontmatter.txfs}`>
          <p class="">Kpd Bpk/Ibu/Saudara/i</p>
          <h4 id="invite-name" class="font-bold text-xl capitalize">
            <Namatamu /> nama tamu
          </h4>
          <p class="mt-2">Di Tempat</p>
        </div>
        <label
          for="toggle"
          id="toaudio"
          class=`fade-left opacity-0 px-6 py-2 relative border rounded-full shadow-xl font-bold flex gap-1 w-max ${frontmatter.txfs} ${frontmatter.bgsc}`
        >
          Open Invitation <Icon path="mdi:love-letter" primary="w-5 h-5" />
        </label>
      </div>
    </div>
  </section>

  <main id="myDIV" class=`hidden peer-checked:block ${frontmatter.bgsc}`>
    <section
      class=`animasi6 relative bg-cover bg-no-repeat bg-center overflow-hidden before:content-[''] before:bg-gradient-to-t ${frontmatter.before} before:inset-0 before:w-full before:h-full before:absolute before:opacity-70 `
      style={`background-image:url(${frontmatter.imgsc})`}
    >
      <div
        class="container mx-auto flex flex-col justify-center items-center text-white relative z-10 font-poppins"
      >
        <div
          class=`mx-auto text-center h-screen flex flex-col justify-center items-center ${frontmatter.txfs}`
        >
          <h2 class="fade-right opacity-0 text-sm mt-4">WE ARE GETTING MARRIED</h2>
          <div
            class="flip-up opacity-0 flex flex-row gap-2 text-center font-montecarlo text-center text-6xl lg:text-8xl"
          >
            <span>{frontmatter.female}</span>
            <span> & </span>
            <span>{frontmatter.male}</span>
          </div>
          <h3 class="fade-up opacity-0 text-xl md:text-2xl">
            {frontmatter.datefs}
          </h3>
        </div>
      </div>
    </section>

    <section class="animasi2 h-max overflow-hidden relative">
      <div class="container py-20 px-6 mx-auto relative">
        <div class=`flex flex-col text-center items-center ${frontmatter.txfs}`>
          <Icon path="mdi:format-quote-close" primary="w-12 h-12" />
          <p
            class="fade-up opacity-0 sm:max-w-prose px-5 sm:px-0 max-w-none font-poppins"
          >
            {frontmatter.quote}
          </p>
        </div>
      </div>
    </section>
    <section
      class=`animasi5 relative overflow-hidden bg-cover bg-center bg-fixed bg-center before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:opacity-70 before:absolute ${frontmatter.before}`
      style={`background-image:url(${frontmatter.add1})`}
    >
      <div class="container py-32 px-6 mx-auto relative">
        <div
          class=`text-center py-12 px-6 space-y-5 max-w-3xl mx-auto border-4 rounded-md ${frontmatter.txfs} ${frontmatter.bdr}`
        >
        <Countdown countdown={frontmatter.countdown} bgfs={frontmatter.bgth} txfs={frontmatter.txfs} />
          <h2 class="fade-down opacity-0 text-lg max-w-lg mx-auto">
            Kami akan menikah dan kami ingin anda menjadi bagian dari hari
            istimewa kami.
          </h2>
        </div>
      </div>
    </section>
    <section class="animasi4 relative overflow-hidden">
      <div class="container py-20 px-6 mx-auto relative">
        <div
          class=`fade-down flex flex-col text-center items-center mb-9 ${frontmatter.txfs}`
        >
          <p class="fade-down opacity-0 max-w-lg mx-auto">
            <span class="italic mb-3 text-xl">Assalamu’alaikum Wr. Wb.</span>
            <br /> Dengan memohon rahmat dan ridho Allah Subhanahu Wa Ta’ala, insyaa
            Allah kami akan menyelenggarakan acara pernikahan :
          </p>
        </div>
        <div class="mx-auto p-4">
          <div
            class=`flex flex-col sm:flex-row justify-center items-center gap-11 gap-y-11 mx-auto *:rounded-lg *:relative *:${frontmatter.bgfs}`
          >
            <div class="fade-right opacity-0">
              <div
                class="rounded-t-lg w-full h-full aspect-square bg-cover bg-center bg-white flex justify-center items-center"
                style={`background-image:url(${frontmatter.pm1})`}
              >
              </div>
              <h3
                class={`fade-down opacity-0 text-left text-8xl px-6 mt-6 font-nautigal ${frontmatter.txsc}`}
              >
                {frontmatter.female}
              </h3>
              <div class="fade-up opacity-0 font-poppins px-6 pb-6 space-y-3">
                <div class={`${frontmatter.txth}`}>
                  <p class={`text-xl font-bold border-b-2 ${frontmatter.bdr}`}>
                    {frontmatter.fullfemale}
                  </p>
                  <p>{frontmatter.childfemale}</p>
                  <p class={`text-lg font-bold ${frontmatter.txsc}`}>
                    {frontmatter.parentfemale}
                  </p>
                  <p>{frontmatter.cityfemale}</p>
                  <div class="mt-4">
                    <a
                      href={`https://www.instagram.com/${frontmatter.instagramfemale}`}
                      class="flex flex-row gap-2 items-center"
                    >
                      <Icon
                        path="mdi:instagram"
                        primary={`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}`}
                      />
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <div class="fade-left opacity-0">
              <div
                class="rounded-t-lg w-full h-full aspect-square bg-cover bg-center bg-white flex justify-center items-center"
                style={`background-image:url(${frontmatter.pm2})`}
              >
              </div>
              <h3
                class={`fade-down opacity-0 text-left text-8xl px-6 mt-6 font-nautigal ${frontmatter.txsc}`}
              >
                {frontmatter.male}
              </h3>
              <div class="fade-up opacity-0 px-6 pb-6 font-poppins space-y-3">
                <div class={`${frontmatter.txth}`}>
                  <p class={`text-xl font-bold border-b-2 ${frontmatter.bdr}`}>
                    {frontmatter.fullmale}
                  </p>
                  <p>{frontmatter.childmale}</p>
                  <p class={`text-lg font-bold ${frontmatter.txsc}`}>
                    {frontmatter.parentmale}
                  </p>
                  <p>{frontmatter.citymale}</p>
                  <div class="mt-4">
                    <a
                      href={`https://www.instagram.com/${frontmatter.instagrammale}`}
                      class="flex flex-row gap-2 items-center"
                    >
                      <Icon
                        path="mdi:instagram"
                        primary={`w-10 h-10 p-2 rounded-full ${frontmatter.txfs} ${frontmatter.bgsc}`}
                      />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class=`animasi7 overflow-hidden relative ${frontmatter.bgth}`>
      <div class="container mx-auto py-20 px-6 relative">
        <div
          class=`text-center py-20 px-2 my-10 rounded-t-full max-w-4xl w-full mx-auto ${frontmatter.txfs} border-2 ${frontmatter.bdr}`
        >
          <h1 class="text-center font-montecarlo text-5xl">
            Acara Pernikahan
          </h1>
          <img
            class=`flip-right opacity-0 mx-auto aspect-video rounded-md mt-3 border-2 ${frontmatter.bdr}`
            src={frontmatter.imgstory11}
            alt=""
          />
          <Card txfs={frontmatter.txfs} txth={frontmatter.txfs} bgfs={frontmatter.bgfs} bgth={frontmatter.bgth} before={frontmatter.before} datefs={frontmatter.datefs} datesc={frontmatter.datesc} timefs={frontmatter.timefs} timesc={frontmatter.timesc} locationfs={frontmatter.locationfs} locationsc={frontmatter.locationsc} addressfs={frontmatter.addressfs} addresssc={frontmatter.addresssc} mapsfs={frontmatter.mapsfs} mapssc={frontmatter.mapssc} akad={frontmatter.akad} resepsi={frontmatter.resepsi} cols="2" />
          <iframe
            src=`${frontmatter.linkmaps}`
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class=`fade-up opacity-0 mx-auto mt-12 w-full max-w-2xl h-56 md:h-96 rounded-lg p-1 ${frontmatter.bgth}`
          ></iframe>
        </div>
      </div>
    </section>
    <section class="animasi8 overflow-hidden relative">
      <Gallery txsc={frontmatter.txsc} imgstory1={frontmatter.imgstory1} imgstory2={frontmatter.imgstory2} imgstory3={frontmatter.imgstory3} imgstory4={frontmatter.imgstory4} imgstory5={frontmatter.imgstory5} imgstory6={frontmatter.imgstory6} imgstory7={frontmatter.imgstory7} imgstory8={frontmatter.imgstory8} font="nautigal" />
    </section>
    <section
      class="animasi9 relative bg-cover bg-no-repeat bg-center bg-fixed overflow-hidden"
    >
      <div
        class=`absolute inset-0 bg-cover bg-center blur-[1px] before:content-[''] before:bg-gradient-to-b before:to-transparent before:inset-0 before:bg-cover before:absolute before:opacity-70 ${frontmatter.before}`
        style={`background-image:url(${frontmatter.add2})`}
      >
      </div>
      <div class="container py-20 px-6 text-center mx-auto relative">
        <div class=`text-center my-10 ${frontmatter.txfs}`>
          <h2 class=`fade-right opacity-0 text-5xl lg:text-8xl font-nautigal`>
            Wedding Gift
          </h2>
          <p
            class="fade-left opacity-0 max-w-md mx-auto mt-5 text-sm font-poppins"
          >
          Tanpa mengurangi rasa hormat kami bagi tamu yang ingin mengirimkan hadiah kepada kedua mempelai dapat mengirimkannya melalui :
          </p>
        </div>
        <Payment txfs={frontmatter.txfs} txth={frontmatter.txfs} bgth={frontmatter.bgth} before={frontmatter.before} numberbankml={frontmatter.numberbankml} numberbankfml={frontmatter.numberbankfml} namebankml={frontmatter.namebankml} namebankfml={frontmatter.namebankfml} logoml={frontmatter.logoml} logofml={frontmatter.logofml} row="row"  />
      </div>
    </section>

    <section class=`animasi10 overflow-hidden relative ${frontmatter.bgsc}`>
      <div class="container py-20 z-50 px-6 text-center mx-auto relative">
        <h2 class=`fade-right opacity-0 text-center my-5 mb-10 ${frontmatter.txfs} text-6xl md:text-8xl font-nautigal`>
           Doa & Ucapan
        </h2>
        <Rsvp bgfs={frontmatter.bgsc} bgsc={frontmatter.bgfs} txfs={frontmatter.txfs} txsc={frontmatter.txth} />
      </div>
      <Footerpost />
    </section>
    <Audio />
    <audio id="myAudio" loop class="hidden">
      <source src=`/assets/music/${frontmatter.music}.mp3` type="audio/mpeg" />
    </audio>
    <Animation />
  </main>
</Noheader>
