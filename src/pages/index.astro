---
import Home from '../layouts/home.astro';
import '@fontsource-variable/josefin-sans';
import Product from '../layouts/product.astro';
import Button from '../components/button.astro';
import Splide from '../layouts/autoscroll.astro';
import Icon from '../components/icon.astro';
import Panoramic from '../layouts/panoramic.astro';
type MarkdownModule = {
  metadata: {
    title?: string;
    number?: number;
    slug?: string;
    img?: { url?: string; alt?: string };
    link?: string;
    desc?: string;
    price?: string;
    unprice?: string;
  };
  default: any;
};

const loadFiles = async (files: Record<string, () => Promise<any>>) => {
  return await Promise.all(
    Object.entries(files).map(async ([path, resolver]) => {
      const post = await resolver();
      const metadata = post.frontmatter ?? post['frontmatter'] ?? {}; // fallback aman

      const slug = metadata.slug || path.split('/').pop()?.replace('.md', '') || '';

      return {
        frontmatter: metadata,
        slug,
        component: post.default
      };
    })
  );
};

// ✅ Gunakan string literal, TANPA `${}`
const natureFiles = import.meta.glob('../pages/nature/*.md');
const adatFiles = import.meta.glob('../pages/adat/*.md');
const floralFiles = import.meta.glob('../pages/floral/*.md');
const popularFiles = import.meta.glob('../pages/popular/*.md');
const flipFiles = import.meta.glob('../pages/flip/*.md');

const [nature, adat, floral, popular, flip] = await Promise.all([
  loadFiles(natureFiles),
  loadFiles(adatFiles),
  loadFiles(floralFiles),
  loadFiles(popularFiles),
  loadFiles(flipFiles),
]);

let {frontmatter} = Astro.props;

if(!frontmatter) {
  let data = {};
  data["cover"] = '/assets/img-3.webp'
  data["cvrsc"] = '/assets/img-21.webp'
  data["cvrth"] = '/assets/img-15.webp'
  data["cvrfr"] = '/assets/img-5.webp'
  data["cvrfv"] = '/assets/img-38.webp'
  data["cvrsx"] = '/assets/img-42.webp'
  data["cvrsv"] = '/assets/img-46.webp'
  data["cvreg"] = '/assets/img-49.webp'
  data["cvrnn"] = '/assets/img-52.webp'

  frontmatter=data;
}
