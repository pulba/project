---
import Noheader from '../layouts/noheader.astro';
---
<Noheader title="Kirim Undangan | Jejak Bahagia">
<section class="min-h-screen bg-slate-900 bg-cover bg-center relative flex items-center justify-center p-4 sm:p-6 before:content-[''] before:bg-slate-950/80 before:backdrop-blur-xs before:inset-0 before:absolute" style="background-image: url(/assets/img-29.webp);">
  
  <div class="w-full max-w-4xl relative z-10 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden font-poppins">
    
    <!-- Header Kartu -->
    <div class="px-6 py-4 sm:px-8 border-b border-gray-100 bg-gray-50/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
      <div>
        <h1 class="text-base sm:text-lg font-semibold text-gray-900">Kirim Undangan Digital</h1>
        <p class="text-xs text-gray-500">Isi nama tamu tujuan lalu kirim langsung via WhatsApp atau Instagram.</p>
      </div>
      <span class="inline-flex items-center self-start sm:self-auto px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
        Siap Kirim
      </span>
    </div>

    <!-- Body Form -->
    <form id="formSend" class="p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        
        <!-- Kolom Kiri: Input Data (5 kolom di desktop) -->
        <div class="md:col-span-5 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-3">
            <div>
              <label for="female" class="block text-xs font-medium text-gray-600 mb-1">Mempelai Wanita</label>
              <input value="" id="female" type="text" name="female" placeholder="Nama Wanita"
                class="w-full px-3.5 py-2 text-sm text-gray-800 capitalize bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition">
            </div>

            <div>
              <label for="male" class="block text-xs font-medium text-gray-600 mb-1">Mempelai Pria</label>
              <input value="" id="male" type="text" name="male" placeholder="Nama Pria"
                class="w-full px-3.5 py-2 text-sm text-gray-800 capitalize bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition">
            </div>
          </div>

          <div>
            <label for="Penerima" class="block text-xs font-medium text-gray-700 mb-1">
              Nama Tamu / Penerima <span class="text-rose-500">*</span>
            </label>
            <input value="" id="Penerima" type="text" name="penerima" placeholder="Contoh: Bapak Budi Santoso"
              class="w-full px-3.5 py-2 text-sm text-gray-900 capitalize bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/15 transition">
          </div>

          <div>
            <label for="igUsername" class="block text-xs font-medium text-gray-600 mb-1">
              Username Instagram <span class="text-gray-400 font-normal">(opsional)</span>
            </label>
            <div class="relative">
              <span class="inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 text-sm absolute">@</span>
              <input value="" id="igUsername" type="text" name="igUsername" placeholder="username_tamu"
                class="w-full pl-7 pr-3.5 py-2 text-sm text-gray-800 lowercase bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-pink-600 focus:ring-2 focus:ring-pink-600/15 transition">
            </div>
            <p class="mt-1 text-[11px] text-gray-400">Otomatis menyalin teks & membuka profil/DM IG.</p>
          </div>

          <input type="tel" id="number" class="hidden" placeholder="Nomor Whatsapp">
        </div>

        <!-- Kolom Kanan: Pratinjau Pesan (7 kolom di desktop) -->
        <div class="md:col-span-7">
          <div class="flex items-center justify-between mb-1">
            <label for="message" class="block text-xs font-medium text-gray-600">Pratinjau Teks Undangan</label>
            <span class="text-[11px] text-gray-400">Dapat diedit manual</span>
          </div>
          <textarea id="message" rows="12" name="content"
            class="block w-full p-3.5 text-xs sm:text-[13px] leading-relaxed text-gray-700 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:outline-none focus:border-gray-400 transition resize-none"></textarea>
        </div>

      </div>
    
      <!-- Footer Tombol Aksi -->
      <div class="mt-6 pt-4 border-t border-gray-100 flex flex-wrap items-center justify-end gap-2.5">
        
        <!-- Tombol Salin -->
        <button id="btnCopy" type="button"
          class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs sm:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg shadow-2xs hover:bg-gray-50 active:scale-[0.99] transition cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span id="copyLabel">Salin Teks</span>
        </button>

        <!-- Tombol Instagram -->
        <button id="sendIG" type="button"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-medium text-white bg-gradient-to-tr from-amber-500 via-pink-600 to-purple-600 rounded-lg shadow-2xs hover:brightness-110 active:scale-[0.99] transition cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          <span id="igLabel">Kirim IG</span>
        </button>

        <!-- Tombol WhatsApp -->
        <button id="send" type="submit"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-medium text-white bg-emerald-600 rounded-lg shadow-2xs hover:bg-emerald-700 active:scale-[0.99] transition cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.758.459 3.475 1.331 4.988L2 22l5.188-1.361a9.93 9.93 0 0 0 4.843 1.258h.004c5.515 0 9.969-4.453 9.969-9.969A9.91 9.91 0 0 0 19.08 4.92 9.91 9.91 0 0 0 12.031 2Zm5.821 14.236c-.246.693-1.428 1.326-1.984 1.409-.506.076-1.146.108-1.85-.116-.427-.136-.975-.317-1.676-.62-2.948-1.273-4.873-4.242-5.02-4.438-.147-.196-1.199-1.595-1.199-3.043 0-1.448.759-2.16 1.028-2.454.27-.294.588-.368.784-.368.196 0 .392.002.563.01.181.009.423-.069.662.505.245.588.833 2.036.906 2.183.074.147.123.319.025.515-.098.196-.147.319-.294.49-.147.172-.309.383-.441.515-.147.147-.3.306-.129.6.172.294.762 1.257 1.636 2.036 1.124 1.002 2.071 1.313 2.365 1.46.294.147.466.123.638-.074.172-.196.735-.858.931-1.152.196-.294.392-.245.662-.147.27.098 1.716.809 2.01.956.294.147.49.221.563.343.074.123.074.711-.172 1.404Z"/></svg>
          <span>Kirim WhatsApp</span>
        </button>

      </div>
    </form>
  </div>

  <!-- Toast Notifikasi Mengambang (Mencegah tombol melar) -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-300 bg-gray-900 text-white text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="toastText">Teks berhasil disalin!</span>
  </div>

</section>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const female = urlParams.get('female');
  const male = urlParams.get('male');
  const urlValue = urlParams.get('url') || 'https://jejakbahagia.com';

  document.getElementById('female').value = decodeURIComponent(female || '');
  document.getElementById('male').value = decodeURIComponent(male || '');

  function showToast(text) {
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toastText');
    toastText.textContent = text;
    toast.classList.remove('opacity-0', 'translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');

    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-2');
    }, 2800);
  }

  function capitalizeAllWords(sentence) {
    sentence = sentence.toLowerCase();
    let words = sentence.split(' ');
    for (let i = 0; i < words.length; i++) {
      if (words[i].length > 0) {
        words[i] = words[i].charAt(0).toUpperCase() + words[i].slice(1);
      }
    }
    sentence = words.join(' ');
    sentence = sentence.replace(/(\.\s*(\w))/g, function(match, p1, p2) {
      return p1.replace(p2, p2.toUpperCase());
    });
    return sentence;
  }

  function updateMessage() {
    const femaleName = capitalizeAllWords(document.getElementById("female").value.trim());
    const maleName = capitalizeAllWords(document.getElementById("male").value.trim());
    const Penerima = capitalizeAllWords(document.getElementById("Penerima").value.trim());
    const cleanBaseURL = urlValue.replace(/\/+$/, '');

    const message = `_Assalamualaikum Warahmatullahi Wabarakaatuh_

Tanpa mengurangi rasa hormat, perkenankan kami mengundang Bapak/Ibu/Saudara/i *${Penerima}* untuk menghadiri acara kami.

*${femaleName}* dengan *${maleName}*

*Berikut link undangan kami,* untuk info lengkap dari acara bisa kunjungi:

${cleanBaseURL}/?to=${encodeURIComponent(Penerima)}

Merupakan suatu kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan untuk hadir dan memberikan doa restu.

*Mohon maaf perihal undangan hanya dibagikan melalui pesan ini.* Dan agar selalu menjaga kesehatan bersama serta datang pada waktu yang telah ditentukan.

Terima kasih banyak atas perhatiannya.

_Wassalamualaikum Warahmatullahi Wabarakaatuh_

Kami yang berbahagia,

*${femaleName} & ${maleName}*`;

    document.getElementById('message').value = message;
  }

  function getPlainTextMessage() {
    const rawMessage = document.getElementById("message").value.trim();
    return rawMessage
      .replace(/\*/g, '')
      .replace(/(^|\s)_|_(?=\s|$)/g, '$1');
  }

  function getCleanIgUsername() {
    const raw = document.getElementById("igUsername").value.trim();
    if (!raw) return "";
    return raw
      .replace(/^https?:\/\/(www\.)?instagram\.com\//i, '')
      .replace(/[/?#].*$/, '')
      .replace(/^@+/, '')
      .trim();
  }

  const isMobileDevice = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  // 1. Kirim WhatsApp
  document.getElementById("formSend").addEventListener("submit", function(e) {
    e.preventDefault();
    const Number = document.getElementById("number").value.trim();
    const message = document.getElementById("message").value.trim();
    const whatsapp = "https://api.whatsapp.com/send?phone=" + Number + "&text=" + encodeURIComponent(message);
    window.open(whatsapp, "_blank");
  });

  // 2. Kirim Instagram
  document.getElementById("sendIG").addEventListener("click", async function() {
    const plainMessage = getPlainTextMessage();
    const username = getCleanIgUsername();

    if (isMobileDevice && navigator.share) {
      navigator.clipboard?.writeText(plainMessage).catch(() => {});
      try {
        await navigator.share({ text: plainMessage });
      } catch (err) {
        if (err.name !== 'AbortError') {
          window.open("https://www.instagram.com/direct/inbox/", "_blank");
        }
      }
      return;
    }

    const targetUrl = username
      ? `https://www.instagram.com/${encodeURIComponent(username)}/`
      : "https://www.instagram.com/direct/inbox/";

    try {
      await navigator.clipboard.writeText(plainMessage);
      showToast(username ? `Teks disalin! Membuka @${username}...` : "Teks disalin! Membuka DM Instagram...");
    } catch (err) {
      showToast("Membuka Instagram...");
    }

    setTimeout(() => {
      window.open(targetUrl, "_blank");
    }, 600);
  });

  // 3. Salin Teks
  document.getElementById("btnCopy").addEventListener("click", async function() {
    const plainMessage = getPlainTextMessage();
    const copyLabel = document.getElementById("copyLabel");

    await navigator.clipboard.writeText(plainMessage);
    copyLabel.textContent = "Tersalin";
    showToast("Teks undangan berhasil disalin!");

    setTimeout(() => {
      copyLabel.textContent = "Salin Teks";
    }, 2000);
  });

  document.getElementById("female").addEventListener("input", updateMessage);
  document.getElementById("male").addEventListener("input", updateMessage);
  document.getElementById("Penerima").addEventListener("input", updateMessage);

  window.onload = updateMessage;
</script>
</Noheader>