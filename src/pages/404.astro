---
import Page from "../layouts/page.astro";
import Icon from "../components/icon.astro";
---

<Page title="Error |" desc="Ini halaman error dari undangan">
    <section>
        <div
            class="container flex items-center min-h-screen px-6 py-12 mx-auto"
        >
            <div
                class="flex flex-col items-center max-w-sm mx-auto text-center"
            >
                <p
                    class="p-3 text-sm font-medium text-blue-500 rounded-full bg-blue-100"
                >
                    <Icon path="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" primary="text-blue-600 w-12 h-12" />
                </p>
                <h1
                    class="mt-3 text-2xl font-semibold text-gray-800 dark:text-white md:text-3xl"
                >
                    Page not found
                </h1>
                <p class="mt-4 text-gray-500 dark:text-gray-400">
                    The page you are looking for doesn't exist. Here are some
                    helpful links:
                </p>
                <div class="flex flex-row gap-2 items-center justify-center mt-5">
                    <button
                        onclick="history.back()"
                        class="flex gap-1 items-center font-bold px-6 py-2 tracking-wide mx-auto text-white bg-blue-600"
                    >
                        <Icon
                            path="M21 16.811c0 .864-.933 1.406-1.683.977l-7.108-4.061a1.125 1.125 0 0 1 0-1.954l7.108-4.061A1.125 1.125 0 0 1 21 8.689v8.122ZM11.25 16.811c0 .864-.933 1.406-1.683.977l-7.108-4.061a1.125 1.125 0 0 1 0-1.954l7.108-4.061a1.125 1.125 0 0 1 1.683.977v8.122Z"
                            primary="text-white w-6 h-6"
                        /> Back
                    </button>
                    <a href="/">
                        <button
                            class="flex gap-1 items-center font-bold px-6 py-2 tracking-wide mx-auto text-white bg-blue-600"
                        >
                            Home <Icon
                                path="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                                primary="text-white w-6 h-6"
                            />
                        </button>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Page>
