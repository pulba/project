---
import Page from "../layouts/page.astro";
import Product from "../layouts/product.astro";
type MarkdownModule = {
  metadata: {
    title?: string;
    number?: number;
    slug?: string;
    img?: { url?: string; alt?: string };
    link?: string;
    desc?: string;
    price?: string;
    unprice?: string;
  };
  default: any;
};

const loadFiles = async (files: Record<string, () => Promise<any>>) => {
  return await Promise.all(
    Object.entries(files).map(async ([path, resolver]) => {
      const post = await resolver();
      const metadata = post.frontmatter ?? post['frontmatter'] ?? {}; // fallback aman

      const slug = metadata.slug || path.split('/').pop()?.replace('.md', '') || '';

      return {
        frontmatter: metadata,
        slug,
        component: post.default
      };
    })
  );
};

// ✅ Gunakan string literal, TANPA `${}`
const undanganFiles = import.meta.glob('../pages/undangan/*.md');

const [undangan] = await Promise.all([
  loadFiles(undanganFiles),
]);
---

<Page
  title="Customer |"
  desc="Jadilah bagian dari mereka yang berbahagia menggunakan tema kami" subs="Jadilah bagian dari mereka yang berbahagia menggunakan tema kami"
  name="Pilihan Customer"
>
  <section>
    <div class="container px-6 py-20 mx-auto text-center">
      <div
        class="grid grid-cols-1 min-[451px]:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 max-w-screen-lg mx-auto"
      >
        {
          undangan
            .slice(0, 15)
            .map((post) => (
              <Product
                primary=""
                aspect="video"
                slug={post.frontmatter.slug || ""}
                link={post.frontmatter.link || ""}
                src={post.frontmatter.img?.url || ""}
                title={post.frontmatter.name || ""}
                alt={post.frontmatter.img?.alt || ""}
                desc={post.frontmatter.desc || ""}
              />
            ))
        }
      </div>
    </div>
  </section>
</Page>
